{
  "name": "dayjoy-website-chat",
  "version": "0.2.0",
  "private": true,
  "description": "Dayjoy AI — production-ready embeddable website chat widget (full-page + floating).",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "build:widget": "next build && node scripts/build-widget.mjs",
    "start": "next start",
    "lint": "eslint src --ext .ts,.tsx --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf .next out node_modules"
  },
  "dependencies": {
    "next": "^16.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "lucide-react": "^1.31.0",
    "framer-motion": "^13.1.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.5.2",
    "class-variance-authority": "^0.7.0",
    "@radix-ui/react-slot": "^1.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.6.0",
    "eslint": "^10.8.1",
    "eslint-config-next": "^15.0.0",
    "tailwindcss": "^4.0.0-beta.3",
    "@tailwindcss/postcss": "^4.0.0-beta.3",
    "postcss": "^8.4.47",
    "autoprefixer": "^10.4.20"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  }
}
