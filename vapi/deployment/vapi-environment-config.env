# ====================================
# Vapi Voice AI — Environment Variables
# ====================================
#
# This file is the source of truth for all Voice AI configuration.
# In production, secrets (marked `<FROM_SECRETS_MANAGER>`) are
# injected via ExternalSecrets from AWS Secrets Manager — they
# should NEVER be committed with real values.
#
# Copy this file to `.env` for local development and fill in the
# placeholder values.

# ---------- App ----------
NODE_ENV=production
PORT=3001
APP_NAME=dayjoy-voice-ai
API_VERSION=v1
LOG_LEVEL=info
LOG_FORMAT=json

# ---------- Database ----------
# PostgreSQL 15+ with pgvector extension. Use pgBouncer in production
# for connection pooling (port 6432).
DATABASE_URL=<FROM_SECRETS_MANAGER>
DATABASE_POOL_SIZE=20
DATABASE_IDLE_TIMEOUT=30000
DATABASE_CONNECTION_TIMEOUT=10000

# ---------- Redis (session memory + rate limiting) ----------
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=
REDIS_TLS_ENABLED=false

# ---------- Vapi ----------
# VAPI_API_KEY and VAPI_WEBHOOK_SECRET are sourced from AWS Secrets
# Manager via ExternalSecrets in production. Locally, set them in .env.
VAPI_API_KEY=<FROM_SECRETS_MANAGER>
VAPI_WEBHOOK_SECRET=<FROM_SECRETS_MANAGER>
VAPI_WEBHOOK_URL=https://api.dayjoy.ai/api/voice/webhook
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=
VAPI_VOICE_ID=rachel
VAPI_MODEL=gpt-4o
VAPI_TEMPERATURE=0.7
VAPI_MAX_TOKENS=500
VAPI_API_BASE_URL=https://api.vapi.ai

# Voice agent settings
VAPI_ASSISTANT_NAME=Dayjoy Support Agent
VAPI_FIRST_MESSAGE=Hi! Thank you for calling Dayjoy. This is Sarah, your virtual assistant. How can I help you today?
VAPI_SILENCE_TIMEOUT_SECONDS=30
VAPI_MAX_DURATION_SECONDS=1800
VAPI_END_CALL_PHRASES=thank you,that's all,goodbye,bye,have a great day

# ---------- OpenAI ----------
OPENAI_API_KEY=<FROM_SECRETS_MANAGER>
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ---------- JWT (for API auth) ----------
JWT_SECRET=<FROM_SECRETS_MANAGER>
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRATION=7d

# ---------- CORS ----------
CORS_ORIGIN=https://app.dayjoy.ai,https://admin.dayjoy.ai
CORS_CREDENTIALS=true

# ---------- Logging ----------
LOG_LEVEL=info
LOG_AGGREGATION_ENABLED=true
LOG_RETENTION_DAYS=30

# ---------- Monitoring ----------
APM_ENABLED=true
APM_SERVICE_NAME=dayjoy-voice-ai
APM_ENVIRONMENT=production
SENTRY_DSN=<FROM_SECRETS_MANAGER>
METRICS_ENABLED=true
METRICS_PORT=9090
METRICS_PATH=/metrics

# ---------- Rate Limiting ----------
# Webhook endpoint can receive bursts of events (transcript updates
# arrive every few hundred ms). Allow up to 1000/minute per IP.
RATE_LIMIT_WEBHOOK_MAX=1000
RATE_LIMIT_WEBHOOK_WINDOW_MS=60000
# API endpoints (call init, list calls, etc.) get a tighter limit.
RATE_LIMIT_API_MAX=100
RATE_LIMIT_API_WINDOW_MS=60000

# ---------- Feature Flags ----------
FEATURE_VOICE_RECORDING=true
FEATURE_TRANSCRIPTION=true
FEATURE_SENTIMENT_ANALYSIS=true
FEATURE_HUMAN_TRANSFER=true
FEATURE_AI_EVALUATION=true
FEATURE_REAL_TIME_DASHBOARD=true

# ---------- Human Transfer ----------
HUMAN_TRANSFER_PHONE_NUMBER=
HUMAN_TRANSFER_QUEUE=support
HUMAN_TRANSFER_WAIT_TIME_SECONDS=30

# ---------- Call Settings ----------
CALL_SILENCE_TIMEOUT_SECONDS=30
CALL_MAX_DURATION_SECONDS=1800
CALL_BACKCHANNELING_ENABLED=true
CALL_BACKGROUND_SOUND=office

# ---------- Escalation ----------
ESCALATION_EMAIL=escalations@dayjoy.ai
ESCALATION_SLACK_CHANNEL=#voice-escalations
ESCALATION_SLACK_WEBHOOK_URL=<FROM_SECRETS_MANAGER>

# ---------- Tool Service URLs (downstream microservices) ----------
RAG_SERVICE_URL=http://rag-service:3001/api/rag/search
PRODUCT_SERVICE_URL=http://product-service:3001/api/products
CUSTOMER_SERVICE_URL=http://customer-service:3001/api/customers
DISTRIBUTOR_SERVICE_URL=http://distributor-service:3001/api/distributors
LEAD_SERVICE_URL=http://lead-service:3001/api/leads
APPOINTMENT_SERVICE_URL=http://appointment-service:3001/api/appointments
TICKET_SERVICE_URL=http://ticket-service:3001/api/tickets
TRANSFER_SERVICE_URL=http://transfer-service:3001/api/transfer

# ---------- Email (notifications) ----------
EMAIL_ENABLED=true
EMAIL_FROM=voice-ai@dayjoy.ai
EMAIL_SERVICE=sendgrid
SENDGRID_API_KEY=<FROM_SECRETS_MANAGER>

# ---------- SMS (notifications) ----------
SMS_ENABLED=true
SMS_SERVICE=twilio
TWILIO_ACCOUNT_SID=<FROM_SECRETS_MANAGER>
TWILIO_AUTH_TOKEN=<FROM_SECRETS_MANAGER>
TWILIO_FROM_NUMBER=+15551234567

# ---------- Storage (call recordings) ----------
STORAGE_BUCKET=s3://dayjoy-voice-recordings
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=<FROM_SECRETS_MANAGER>
STORAGE_SECRET_KEY=<FROM_SECRETS_MANAGER>
CDN_URL=https://cdn.dayjoy.ai

# ---------- Health Check ----------
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_PATH=/health
HEALTH_CHECK_INTERVAL=30

# ---------- Graceful Shutdown ----------
SHUTDOWN_TIMEOUT=30000
SHUTDOWN_GRACE_PERIOD=5000

# ---------- Backup ----------
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_BUCKET=s3://dayjoy-backups

# ---------- Cache ----------
CACHE_ENABLED=true
CACHE_TTL=3600
CACHE_MAX_SIZE=1000

# ---------- Concurrency ----------
MAX_CONCURRENT_CALLS=100
MAX_CONCURRENT_TOOLS=50
WORKER_THREADS=4

# ---------- Debug (DISABLE in production) ----------
DEBUG_ENABLED=false
DEBUG_PORT=9229
INSPECTOR_ENABLED=false
