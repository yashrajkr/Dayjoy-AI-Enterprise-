{
  "name": "Email — Password Reset",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "email/password-reset",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "a2e5-0001-reset-webhook",
      "name": "Webhook: password.reset.requested",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "webhookId": "a2e5-reset-webhook-id"
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "combinator": "and",
          "conditions": [
            { "id": "cond-event", "leftValue": "={{ $json.body.event }}", "rightValue": "password.reset.requested", "operator": { "type": "string", "operation": "equals" } },
            { "id": "cond-token", "leftValue": "={{ $json.body.data.resetToken }}", "rightValue": "", "operator": { "type": "string", "operation": "isNotEmpty" } },
            { "id": "cond-email", "leftValue": "={{ $json.body.data.email }}", "rightValue": "", "operator": { "type": "string", "operation": "isNotEmpty" } }
          ]
        },
        "options": {}
      },
      "id": "a2e5-0002-reset-filter",
      "name": "Filter: Reset Event + Token",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "jsCode": "const r = $input.all()[0].json.body.data;\nconst resetLink = `${process.env.DAYJOY_WEB_BASE_URL || 'https://app.dayjoy.in'}/reset-password?token=${encodeURIComponent(r.resetToken)}&email=${encodeURIComponent(r.email)}`;\nconst html = `\n<!doctype html><html><body style=\"font-family:Arial,Helvetica,sans-serif;color:#1f2937;background:#fff7ed;margin:0;padding:0;\">\n  <div style=\"max-width:560px;margin:0 auto;padding:32px;\">\n    <h1 style=\"color:#ea580c;\">Password Reset Request 🔐</h1>\n    <p>Hi ${r.name || r.firstName || 'there'},</p>\n    <p>We received a request to reset the password for your Dayjoy account. Click the button below to set a new password.</p>\n    <p style=\"margin:24px 0;\">\n      <a href=\"${resetLink}\" style=\"background:#ea580c;color:#fff;padding:12px 24px;border-radius:6px;text-decoration:none;display:inline-block;font-size:16px;\">Reset Password →</a>\n    </p>\n    <p style=\"background:#fef3c7;border-left:4px solid #f59e0b;padding:12px;font-size:14px;\">\n      <strong>⏱️ This link expires in 1 hour.</strong> If you didn't request this reset, you can safely ignore this email — your password will remain unchanged.\n    </p>\n    <h2 style=\"color:#9a3412;\">Security Tips</h2>\n    <ul>\n      <li>Use a strong, unique password (8+ characters, mix of letters, numbers, symbols).</li>\n      <li>Never share your password or reset link with anyone.</li>\n      <li>Enable two-factor authentication if available.</li>\n      <li>Dayjoy staff will never ask for your password.</li>\n    </ul>\n    <p>If the button doesn't work, copy this link: <br/><a href=\"${resetLink}\">${resetLink}</a></p>\n    <hr style=\"margin:24px 0;border:none;border-top:1px solid #fed7aa;\" />\n    <p style=\"font-size:12px;color:#6b7280;\">Dayjoy Wellness Pvt. Ltd. · security@dayjoy.in</p>\n  </div>\n</body></html>`;\nreturn [{ json: { html, subject: 'Reset your Dayjoy password', recipientEmail: r.email, resetLink, userId: r.userId, tenantId: r.tenantId, expiresAt: r.expiresAt } }];"
      },
      "id": "a2e5-0003-reset-compose",
      "name": "Code: Compose Reset Email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [440, 0]
    },
    {
      "parameters": {
        "fromEmail": "security@dayjoy.in",
        "toEmail": "={{ $json.recipientEmail }}",
        "subject": "={{ $json.subject }}",
        "emailFormat": "html",
        "html": "={{ $json.html }}",
        "options": {}
      },
      "id": "a2e5-0004-reset-send",
      "name": "Send: Password Reset Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [660, 0],
      "credentials": { "smtp": { "id": "smtp-cred-id", "name": "smtp" } },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.DAYJOY_API_BASE_URL }}/api/notifications/audit",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"channel\": \"EMAIL\",\n  \"event\": \"password_reset_email_sent\",\n  \"userId\": \"{{ $json.userId }}\",\n  \"recipientEmail\": \"{{ $json.recipientEmail }}\",\n  \"status\": \"SENT\",\n  \"tenantId\": \"{{ $json.tenantId }}\",\n  \"metadata\": { \"workflow\": \"password-reset\", \"expiresAt\": \"{{ $json.expiresAt }}\" }\n}",
        "options": { "timeout": 10000 }
      },
      "id": "a2e5-0005-reset-audit",
      "name": "Log: Audit Reset Email",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [880, 0],
      "credentials": { "httpHeaderAuth": { "id": "dayjoyApi", "name": "dayjoyApi" } },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    }
  ],
  "connections": {
    "Webhook: password.reset.requested": { "main": [ [ { "node": "Filter: Reset Event + Token", "type": "main", "index": 0 } ] ] },
    "Filter: Reset Event + Token": { "main": [ [ { "node": "Code: Compose Reset Email", "type": "main", "index": 0 } ] ] },
    "Code: Compose Reset Email": { "main": [ [ { "node": "Send: Password Reset Email", "type": "main", "index": 0 } ] ] },
    "Send: Password Reset Email": { "main": [ [ { "node": "Log: Audit Reset Email", "type": "main", "index": 0 } ] ] }
  },
  "settings": { "executionOrder": "v1", "saveExecutionProgress": true, "saveManualExecutions": true, "callerPolicy": "workflowsFromSameOwner" },
  "active": false,
  "tags": [{ "name": "email" }, { "name": "security" }, { "name": "dayjoy" }]
}
