{
  "name": "CRM — Employee Notification Router",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "crm-employee-notifications",
        "responseMode": "responseNode",
        "options": {
          "rawData": true,
          "binaryPropertyName": "data"
        }
      },
      "id": "a1-crm-emp-001",
      "name": "CRM Event Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 300],
      "webhookId": "d5a1f3c9-crm-employee-notifications-webhook"
    },
    {
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst headers = items[0].json.headers || {};\nconst secret = process.env.DAYJOY_WEBHOOK_SECRET;\nconst signature = headers['x-dayjoy-signature'];\nconst timestamp = headers['x-dayjoy-timestamp'];\nconst eventId = headers['x-dayjoy-event-id'];\nconst eventType = headers['x-dayjoy-event'];\nif (!signature || !timestamp || !eventId || !eventType) throw new Error('Missing required headers');\nif (Math.abs(Math.floor(Date.now()/1000) - parseInt(timestamp,10)) > 300) throw new Error('Stale timestamp');\nconst bodyBuffer = await this.helpers.getBinaryDataBuffer(items[0], 'data');\nconst expected = 'sha256=' + crypto.createHmac('sha256', secret).update(bodyBuffer).digest('hex');\nconst sigBuf = Buffer.from(signature), expBuf = Buffer.from(expected);\nif (sigBuf.length !== expBuf.length || !crypto.timingSafeEqual(sigBuf, expBuf)) throw new Error('Invalid signature');\nconst ALLOWED = ['order.high_value', 'customer.complaint', 'lead.hot', 'distributor.tier_up', 'refund.requested', 'support.escalation'];\nif (!ALLOWED.includes(eventType)) throw new Error('Unexpected event: ' + eventType);\nconst payload = JSON.parse(bodyBuffer.toString('utf8'));\npayload._meta = { eventId, eventType, receivedAt: new Date().toISOString() };\nreturn [{ json: payload }];"
      },
      "id": "a1-crm-emp-002",
      "name": "Verify HMAC Signature",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 300],
      "notes": "Allow-list: order.high_value, customer.complaint, lead.hot, distributor.tier_up, refund.requested, support.escalation"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.DAYJOY_API_BASE_URL }}/api/automation/event-dedup",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "Bearer {{ $env.DAYJOY_AUTOMATION_JWT }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"eventId\":\"{{ $json._meta.eventId }}\"}",
        "options": {
          "response": { "response": { "fullResponse": true } },
          "retry": { "enabled": true, "maxTries": 3, "retryInterval": 1000 }
        }
      },
      "id": "a1-crm-emp-003",
      "name": "Event Dedup Check",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 300]
    },
    {
      "parameters": {
        "jsCode": "// Map event → target employee role + priority\nconst ROUTING = {\n  'order.high_value':    { role: 'SALES_MANAGER',     priority: 'HIGH',   template: 'HIGH_VALUE_ORDER' },\n  'customer.complaint':  { role: 'SUPPORT_LEAD',      priority: 'URGENT', template: 'CUSTOMER_COMPLAINT' },\n  'lead.hot':            { role: 'SALES_REP',         priority: 'HIGH',   template: 'HOT_LEAD_ALERT' },\n  'distributor.tier_up': { role: 'PARTNERSHIPS_MGR',  priority: 'MEDIUM', template: 'DISTRIBUTOR_TIER_UP' },\n  'refund.requested':    { role: 'FINANCE_OFFICER',   priority: 'HIGH',   template: 'REFUND_REQUESTED' },\n  'support.escalation':  { role: 'SUPPORT_LEAD',      priority: 'URGENT', template: 'SUPPORT_ESCALATION' }\n};\nconst eventType = items[0].json._meta.eventType;\nconst route = ROUTING[eventType] || { role: 'ADMIN', priority: 'MEDIUM', template: 'GENERIC_CRM_EVENT' };\n\nreturn [{\n  json: {\n    ...items[0].json,\n    _route: route\n  }\n}];"
      },
      "id": "a1-crm-emp-004",
      "name": "Route by Event→Role",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [660, 300],
      "notes": "Event → role mapping: high_value→SALES_MANAGER, complaint→SUPPORT_LEAD, hot→SALES_REP, tier_up→PARTNERSHIPS_MGR, refund→FINANCE_OFFICER, escalation→SUPPORT_LEAD"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.DAYJOY_API_BASE_URL }}/api/employees?role={{ $json._route.role }}&active=true",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "options": {
          "response": { "response": { "fullResponse": true } },
          "retry": { "enabled": true, "maxTries": 3, "retryInterval": 1000 }
        }
      },
      "id": "a1-crm-emp-005",
      "name": "Fetch Employees by Role",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [880, 300],
      "credentials": { "httpHeaderAuth": { "id": "dayjoyApi", "name": "dayjoyApi" } },
      "notes": "GET /api/employees?role=<role>&active=true"
    },
    {
      "parameters": {
        "jsCode": "const resp = $json.body || $json;\nconst employees = resp.data || resp.employees || [];\nif (!employees.length) {\n  return [{ json: { ...$('Route by Event→Role').item.json, _employees: [], _escalate: true } }];\n}\n// Round-robin within role (lowest lastNotifiedAt wins)\nemployees.sort((a, b) => new Date(a.lastNotifiedAt || 0).getTime() - new Date(b.lastNotifiedAt || 0).getTime());\nconst recipient = employees[0];\nreturn [{\n  json: {\n    ...$('Route by Event→Role').item.json,\n    _employees: employees,\n    _recipient: recipient,\n    _escalate: false\n  }\n}];"
      },
      "id": "a1-crm-emp-006",
      "name": "Pick Recipient (Round-Robin)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1100, 300]
    },
    {
      "parameters": {
        "rules": {
          "rules": [
            {
              "value1": "={{ $json._escalate }}",
              "value2": false,
              "operation": "equal",
              "outputKey": "found"
            }
          ]
        },
        "fallbackOutput": 1
      },
      "id": "a1-crm-emp-007",
      "name": "Recipient Found?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1320, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.DAYJOY_API_BASE_URL }}/api/notifications/send",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"channel\":\"IN_APP\",\"recipient\":\"{{ $json._recipient.id }}\",\"template\":\"{{ $json._route.template }}\",\"context\":{{ JSON.stringify(Object.assign({}, $json, { _omit: undefined, _route: undefined, _employees: undefined, _recipient: undefined })) }},\"priority\":\"{{ $json._route.priority }}\"}",
        "options": {
          "response": { "response": { "fullResponse": true } },
          "retry": { "enabled": true, "maxTries": 3, "retryInterval": 1000 }
        }
      },
      "id": "a1-crm-emp-008",
      "name": "Send In-App Notification",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1540, 220],
      "credentials": { "httpHeaderAuth": { "id": "dayjoyApi", "name": "dayjoyApi" } }
    },
    {
      "parameters": {
        "rules": {
          "rules": [
            {
              "value1": "={{ $('Pick Recipient (Round-Robin)').item.json._route.priority }}",
              "value2": "HIGH",
              "operation": "equal",
              "outputKey": "high"
            },
            {
              "value1": "={{ $('Pick Recipient (Round-Robin)').item.json._route.priority }}",
              "value2": "URGENT",
              "operation": "equal",
              "outputKey": "urgent"
            }
          ]
        },
        "fallbackOutput": 2
      },
      "id": "a1-crm-emp-009",
      "name": "Priority HIGH/URGENT?",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 1,
      "position": [1760, 220],
      "notes": "HIGH or URGENT priority → also send email"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.DAYJOY_API_BASE_URL }}/api/notifications/send",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"channel\":\"EMAIL\",\"recipient\":\"{{ $('Pick Recipient (Round-Robin)').item.json._recipient.email }}\",\"template\":\"{{ $('Pick Recipient (Round-Robin)').item.json._route.template }}\",\"priority\":\"{{ $('Pick Recipient (Round-Robin)').item.json._route.priority }}\"}",
        "options": {
          "response": { "response": { "fullResponse": true } },
          "retry": { "enabled": true, "maxTries": 3, "retryInterval": 1000 }
        }
      },
      "id": "a1-crm-emp-010",
      "name": "Send Email (HIGH/URGENT)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1980, 180],
      "credentials": { "httpHeaderAuth": { "id": "dayjoyApi", "name": "dayjoyApi" } },
      "notes": "Email recipient for HIGH/URGENT priority only"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.DAYJOY_API_BASE_URL }}/api/notifications/send",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"channel\":\"IN_APP\",\"recipient\":\"admin@dayjoy.ai\",\"template\":\"CRM_EVENT_NO_RECIPIENT\",\"context\":{\"eventType\":\"{{ $json._meta.eventType }}\",\"role\":\"{{ $json._route.role }}\"},\"priority\":\"HIGH\"}",
        "options": {
          "response": { "response": { "fullResponse": true } },
          "retry": { "enabled": true, "maxTries": 3, "retryInterval": 1000 }
        }
      },
      "id": "a1-crm-emp-011",
      "name": "Escalate to Admin",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1540, 420],
      "credentials": { "httpHeaderAuth": { "id": "dayjoyApi", "name": "dayjoyApi" } },
      "notes": "No active employees with routed role → escalate to admin"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\"ok\":true,\"eventId\":\"{{ $('Verify HMAC Signature').item.json._meta.eventId }}\"}",
        "options": { "responseCode": 200 }
      },
      "id": "a1-crm-emp-012",
      "name": "Respond 200 Success",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [2200, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\"error\":\"invalid_signature\"}",
        "options": { "responseCode": 401 }
      },
      "id": "a1-crm-emp-013",
      "name": "Respond 401 Auth",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [220, 540]
    }
  ],
  "connections": {
    "CRM Event Webhook": {
      "main": [
        [
          { "node": "Verify HMAC Signature", "type": "main", "index": 0 }
        ]
      ]
    },
    "Verify HMAC Signature": {
      "main": [
        [
          { "node": "Event Dedup Check", "type": "main", "index": 0 }
        ]
      ]
    },
    "Event Dedup Check": {
      "main": [
        [
          { "node": "Route by Event→Role", "type": "main", "index": 0 }
        ]
      ]
    },
    "Route by Event→Role": {
      "main": [
        [
          { "node": "Fetch Employees by Role", "type": "main", "index": 0 }
        ]
      ]
    },
    "Fetch Employees by Role": {
      "main": [
        [
          { "node": "Pick Recipient (Round-Robin)", "type": "main", "index": 0 }
        ]
      ]
    },
    "Pick Recipient (Round-Robin)": {
      "main": [
        [
          { "node": "Recipient Found?", "type": "main", "index": 0 }
        ]
      ]
    },
    "Recipient Found?": {
      "main": [
        [
          { "node": "Send In-App Notification", "type": "main", "index": 0 }
        ],
        [
          { "node": "Escalate to Admin", "type": "main", "index": 0 }
        ]
      ]
    },
    "Send In-App Notification": {
      "main": [
        [
          { "node": "Priority HIGH/URGENT?", "type": "main", "index": 0 }
        ]
      ]
    },
    "Priority HIGH/URGENT?": {
      "main": [
        [
          { "node": "Send Email (HIGH/URGENT)", "type": "main", "index": 0 }
        ],
        [
          { "node": "Send Email (HIGH/URGENT)", "type": "main", "index": 0 }
        ],
        [
          { "node": "Respond 200 Success", "type": "main", "index": 0 }
        ]
      ]
    },
    "Send Email (HIGH/URGENT)": {
      "main": [
        [
          { "node": "Respond 200 Success", "type": "main", "index": 0 }
        ]
      ]
    },
    "Escalate to Admin": {
      "main": [
        [
          { "node": "Respond 200 Success", "type": "main", "index": 0 }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "saveExecutionProgress": true,
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "all"
  },
  "tags": [
    { "name": "crm" },
    { "name": "notifications" },
    { "name": "agent-a1" }
  ],
  "meta": {
    "templateCreatedBy": "Agent A1 — CRM/Sales/Leads",
    "description": "Routes CRM events to the right employee by role. Allow-list: high-value orders, complaints, hot leads, distributor tier-ups, refund requests, support escalations. Round-robin within role. HIGH/URGENT also sends email. Escalates to admin if no active employee with role."
  }
}
