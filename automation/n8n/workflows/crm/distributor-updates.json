        "jsonBody": "={\"fromDistributorId\":\"{{ $json.distributorId }}\",\"toDistributorId\":\"{{ $json.after.sponsorId || $json.after.uplineId }}\",\"reason\":\"distributor_terminated\",\"onlyOpenOrders\":true}",
        "options": {
          "response": { "response": { "fullResponse": true } },
