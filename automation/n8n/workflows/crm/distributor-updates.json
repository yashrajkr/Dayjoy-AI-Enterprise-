        "specifyBody": "json",
        "jsonBody": "={\"channel\":\"IN_APP\",\"recipient\":\"{{ $json.after.sponsorId || $json.after.uplineId }}\",\"template\":\"TERMINATED_DOWNLINE_REASSIGNMENT\",\"context\":{\"terminatedDistributor\":\"{{ $json.distributorName }}\",\"customerCount\":\"{{ $json.reassignedCustomers || 'N/A' }}\"},\"priority\":\"HIGH\"}",
        "options": {
