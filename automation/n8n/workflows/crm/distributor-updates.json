        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"fromDistributorId\":\"{{ $json.distributorId }}\",\"toDistributorId\":\"{{ $json.after.sponsorId || $json.after.uplineId }}\",\"reason\":\"distributor_terminated\"}",
        "options": {
          "response": { "response": { "fullResponse": true } },
          "retry": { "enabled": true, "maxTries": 3, "retryInterval": 1000 }
