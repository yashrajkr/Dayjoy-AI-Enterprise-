        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"event\":\"distributor.status_changed\",\"severity\":\"INFO\",\"meta\":{\"distributorId\":\"{{ $json.distributorId }}\",\"oldStatus\":\"{{ $json.before.status }}\",\"newStatus\":\"{{ $json.after.status }}\"}}",
        "options": {
          "retry": { "enabled": true, "maxTries": 3, "retryInterval": 1000 }
        }
      },
      "id": "a1-crm-dist-013",
      "name": "Log Status Change",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1100, 640],
      "credentials": { "httpHeaderAuth": { "id": "dayjoyApi", "name": "dayjoyApi" } },
      "notes": "status_changed (not TERMINATED) → just audit-log"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.DAYJOY_API_BASE_URL }}/api/audit-log",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"event\":\"distributor.updated\",\"severity\":\"INFO\",\"meta\":{\"distributorId\":\"{{ $json.distributorId }}\",\"changedFields\":{{ JSON.stringify($json.changedFields) }}}}",
        "options": {
          "retry": { "enabled": true, "maxTries": 3, "retryInterval": 1000 }
        }
      },
      "id": "a1-crm-dist-014",
      "name": "Log Minor Update",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1100, 800],
      "credentials": { "httpHeaderAuth": { "id": "dayjoyApi", "name": "dayjoyApi" } },
      "notes": "Fallback for non-routing changes — just audit-log"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\"ok\":true,\"eventId\":\"{{ $('Verify HMAC Signature').item.json._meta.eventId }}\",\"route\":\"{{ $json.route }}\"}",
        "options": { "responseCode": 200 }
      },
      "id": "a1-crm-dist-015",
      "name": "Respond 200 Success",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1760, 460]
    },
    {
      "parameters": {
