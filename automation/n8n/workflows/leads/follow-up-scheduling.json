{
  "name": "Leads — Follow-up Cadence",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "lead-follow-up",
        "responseMode": "responseNode",
        "options": {
          "rawData": true,
          "binaryPropertyName": "data"
        }
      },
      "id": "a1-lead-followup-001",
      "name": "Status Changed Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 300],
      "webhookId": "b3d9f1c7-lead-followup-webhook"
    },
    {
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst headers = items[0].json.headers || {};\nconst secret = process.env.DAYJOY_WEBHOOK_SECRET;\nconst signature = headers['x-dayjoy-signature'];\nconst timestamp = headers['x-dayjoy-timestamp'];\nconst eventId = headers['x-dayjoy-event-id'];\nconst eventType = headers['x-dayjoy-event'];\nif (!signature || !timestamp || !eventId || !eventType) throw new Error('Missing required headers');\nif (Math.abs(Math.floor(Date.now()/1000) - parseInt(timestamp,10)) > 300) throw new Error('Stale timestamp');\nconst bodyBuffer = await this.helpers.getBinaryDataBuffer(items[0], 'data');\nconst expected = 'sha256=' + crypto.createHmac('sha256', secret).update(bodyBuffer).digest('hex');\nconst sigBuf = Buffer.from(signature), expBuf = Buffer.from(expected);\nif (sigBuf.length !== expBuf.length || !crypto.timingSafeEqual(sigBuf, expBuf)) throw new Error('Invalid signature');\nconst ALLOWED = ['lead.status_changed'];\nif (!ALLOWED.includes(eventType)) throw new Error('Unexpected event: ' + eventType);\nconst payload = JSON.parse(bodyBuffer.toString('utf8'));\n// Only trigger cadence when status transitions to CONTACTED\nif ((payload.newStatus || payload.status) !== 'CONTACTED') {\n  throw new Error('Not a CONTACTED transition — skipping cadence');\n}\npayload._meta = { eventId, eventType, receivedAt: new Date().toISOString() };\nreturn [{ json: payload }];"
      },
      "id": "a1-lead-followup-002",
      "name": "Verify HMAC Signature",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 300],
      "notes": "Only fires on status→CONTACTED. Other status changes rejected (no cadence)."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.DAYJOY_API_BASE_URL }}/api/automation/event-dedup",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "Bearer {{ $env.DAYJOY_AUTOMATION_JWT }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"eventId\":\"{{ $json._meta.eventId }}\"}",
        "options": {
          "response": { "response": { "fullResponse": true } },
          "retry": { "enabled": true, "maxTries": 3, "retryInterval": 1000 }
        }
      },
      "id": "a1-lead-followup-003",
