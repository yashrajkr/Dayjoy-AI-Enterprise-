      "typeVersion": 4.2,
      "position": [1100, 300],
      "credentials": { "httpHeaderAuth": { "id": "dayjoyApi", "name": "dayjoyApi" } },
      "notes": "Has lead replied since CONTACTED? Get interactions since webhook receipt."
    },
    {
      "parameters": {
        "jsCode": "const resp = $json.body || $json;\nconst interactions = (resp.data || resp.interactions || []).filter(i => i.direction === 'INBOUND' || i.source === 'lead');\nconst hasResponded = interactions.length > 0;\nreturn [{\n  json: {\n    leadId: $('Verify HMAC Signature').item.json.leadId || $('Verify HMAC Signature').item.json.id,\n    leadEmail: $('Verify HMAC Signature').item.json.email || $('Verify HMAC Signature').item.json.leadEmail,\n    leadPhone: $('Verify HMAC Signature').item.json.phone || $('Verify HMAC Signature').item.json.leadPhone,\n    leadName: ($('Verify HMAC Signature').item.json.firstName || '') + ' ' + ($('Verify HMAC Signature').item.json.lastName || ''),\n    assignedRepId: $('Verify HMAC Signature').item.json.assignedTo || $('Verify HMAC Signature').item.json.assignedRepId,\n    hasResponded,\n    interactionsCount: interactions.length,\n    checkStage: 'T+2d'\n  }\n}];"
      },
      "id": "a1-lead-followup-007",
      "name": "Parse Response Check",
      "type": "n8n-nodes-base.code",
