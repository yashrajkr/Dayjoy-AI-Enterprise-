        "options": { "responseCode": 202 }
      },
      "id": "a1-lead-followup-004",
      "name": "Acknowledge Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [660, 300],
