        "responseBody": "={\"ok\":true,\"eventId\":\"{{ $('Verify HMAC Signature').item.json._meta.eventId }}\",\"leadId\":\"{{ $json.leadId }}\",\"score\":{{ $json.score }},\"tier\":\"{{ $json.tier }}\"}",
