      "id": "a1-lead-score-005",
      "name": "Fetch Lead Interactions",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [880, 300],
      "credentials": { "httpHeaderAuth": { "id": "dayjoyApi", "name": "dayjoyApi" } },
      "notes": "GET /api/leads/:id/interactions — emails, calls, WhatsApp, website visits"
    },
    {
      "parameters": {
        "jsCode": "// Build AI scoring prompt context\nconst lead = $('Fetch Lead Details').item.json.data || $('Fetch Lead Details').item.json;\nconst interactions = $('Fetch Lead Interactions').item.json.data || [];\n\n// Data completeness: 0-30 points\nconst fields = ['firstName','lastName','email','phone','company','territory','budget','timeline'];\nconst filled = fields.filter(f => lead[f] && String(lead[f]).trim()).length;\nconst completeness = Math.round((filled / fields.length) * 30);\n\n// Engagement: 0-40 points (each interaction = 5 pts, max 40)\nconst engagement = Math.min(40, interactions.length * 5);\n\n// Budget signal: 0-15\nconst budget = lead.budget ? 15 : 0;\n\n// Timeline urgency: 0-15 (urgent timeline = high score)\nconst timelineMap = { IMMEDIATE: 15, WEEKS: 10, MONTHS: 5, QUARTERS: 2 };\nconst timeline = timelineMap[lead.timeline] || 0;\n\nconst heuristicScore = Math.min(100, completeness + engagement + budget + timeline);\n\nreturn [{\n  json: {\n    leadId: lead.id,\n    lead,\n    interactions,\n    heuristicScore,\n    breakdown: { completeness, engagement, budget, timeline },\n    prompt: `Score this sales lead 0-100. Heuristic pre-score: ${heuristicScore}/100 (completeness=${completeness}, engagement=${engagement}, budget=${budget}, timeline=${timeline}). Return JSON {score:int, tier:'HOT'|'WARM'|'COLD', reason:string, recommendedAction:string}.`\n  }\n}];"
      },
      "id": "a1-lead-score-006",
      "name": "Build AI Scoring Context",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1100, 300],
      "notes": "Heuristic pre-score + AI prompt context. Heuristic = data completeness + engagement + budget + timeline."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.DAYJOY_API_BASE_URL }}/api/ai/conversations/lead-{{ $json.leadId }}/messages",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"role\":\"system\",\"content\":\"{{ $json.prompt }}\",\"context\":{\"lead\":{{ JSON.stringify($json.lead) }},\"interactions\":{{ JSON.stringify($json.interactions) }},\"heuristicScore\":{{ $json.heuristicScore }},\"breakdown\":{{ JSON.stringify($json.breakdown) }}},\"responseFormat\":\"json\"}",
        "options": {
          "response": { "response": { "fullResponse": true } },
          "retry": { "enabled": true, "maxTries": 3, "retryInterval": 1000 }
        }
      },
      "id": "a1-lead-score-007",
      "name": "AI Score Lead",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1320, 300],
      "credentials": { "httpHeaderAuth": { "id": "dayjoyApi", "name": "dayjoyApi" } },
      "notes": "POST /api/ai/conversations/:id/messages — AI scoring call"
    },
    {
      "parameters": {
        "jsCode": "const resp = $json.body || $json;\nlet score = $('Build AI Scoring Context').item.json.heuristicScore;\nlet tier = 'WARM';\nlet reason = 'heuristic_fallback';\nlet recommendedAction = 'follow_up';\ntry {\n  let parsed = typeof resp === 'string' ? JSON.parse(resp) : resp;\n  if (parsed.data) parsed = parsed.data;\n  if (typeof parsed.score === 'number') score = parsed.score;\n  if (parsed.tier) tier = parsed.tier;\n  if (parsed.reason) reason = parsed.reason;\n  if (parsed.recommendedAction) recommendedAction = parsed.recommendedAction;\n} catch (e) { /* fall back to heuristic */ }\n\n// Override tier based on score buckets\nif (score > 80) tier = 'HOT';\nelse if (score >= 50) tier = 'WARM';\nelse tier = 'COLD';\n\nreturn [{\n  json: {\n    leadId: $('Build AI Scoring Context').item.json.leadId,\n    score,\n    tier,\n    reason,\n    recommendedAction,\n    breakdown: $('Build AI Scoring Context').item.json.breakdown,\n    scoredAt: new Date().toISOString()\n  }\n}];"
      },
      "id": "a1-lead-score-008",
      "name": "Parse Score & Tier",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1540, 300],
      "notes": "Tier buckets: HOT>80, WARM 50-80, COLD<50"
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "={{ $env.DAYJOY_API_BASE_URL }}/api/leads/{{ $json.leadId }}/score",
