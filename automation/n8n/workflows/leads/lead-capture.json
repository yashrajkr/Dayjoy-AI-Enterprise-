      "id": "a1-lead-capture-007",
      "name": "Get Available Reps",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1100, 360],
      "credentials": { "httpHeaderAuth": { "id": "dayjoyApi", "name": "dayjoyApi" } },
      "notesInFlow": true,
      "notes": "GET /api/distributors/available — fetches reps filtered by territory, language, workload"
    },
    {
      "parameters": {
        "jsCode": "// Pick best rep: territory match > language match > round-robin (lowest current workload)\nconst lead = $('Create Lead in CRM').item.json;\nconst reps = $json.data || $json.reps || [];\nif (!reps.length) {\n  return [{ json: { assignedRepId: null, assignmentReason: 'no_reps_available' } }];\n}\n\nconst territory = lead.territory || '';\nconst language = lead.language || 'en';\n\n// 1. Exact territory + language match\nlet candidates = reps.filter(r => r.territory === territory && r.languages && r.languages.includes(language));\nlet reason = 'territory+language';\n\n// 2. Territory match only\nif (!candidates.length) {\n  candidates = reps.filter(r => r.territory === territory);\n  reason = 'territory';\n}\n\n// 3. Language match only\nif (!candidates.length) {\n  candidates = reps.filter(r => r.languages && r.languages.includes(language));\n  reason = 'language';\n}\n\n// 4. Round-robin (lowest workload)\nif (!candidates.length) {\n  candidates = reps;\n  reason = 'round-robin';\n}\n\ncandidates.sort((a, b) => (a.activeLeads || 0) - (b.activeLeads || 0));\nconst assigned = candidates[0];\n\nreturn [{\n  json: {\n    leadId: lead.id || lead.data?.id,\n    assignedRepId: assigned.id,\n    assignedRepName: assigned.name,\n    assignedRepEmail: assigned.email,\n    assignedRepPhone: assigned.phone,\n    assignmentReason: reason,\n    leadFirstName: lead.firstName,\n    leadLastName: lead.lastName,\n    leadEmail: lead.email,\n    leadPhone: lead.phone\n  }\n}];"
      },
