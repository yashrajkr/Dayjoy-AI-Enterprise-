      "position": [2200, 360],
      "credentials": { "httpHeaderAuth": { "id": "dayjoyApi", "name": "dayjoyApi" } },
      "notesInFlow": true,
      "notes": "POST /api/ai/conversations/:id/messages — AI lead scoring call"
    },
    {
      "parameters": {
        "jsCode": "const resp = $json.body || $json;\nlet score = 50;\nlet reason = 'default';\ntry {\n  const parsed = typeof resp === 'string' ? JSON.parse(resp) : resp;\n  if (parsed.data) parsed = parsed.data;\n  score = typeof parsed.score === 'number' ? parsed.score : 50;\n  reason = parsed.reason || 'default';\n} catch (e) {}\nreturn [{ json: { leadId: $('Compute Assignment').item.json.leadId, score, reason, scoredAt: new Date().toISOString() } }];"
      },
