{
  "name": "Support — Ticket Creation (Auto-Assign + SLA + AI Suggestions)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "support/ticket-creation",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "a2s1-0001-tc-webhook",
      "name": "Webhook: ticket.created",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "webhookId": "a2s1-tc-webhook-id"
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "combinator": "and",
          "conditions": [
            { "id": "cond-event", "leftValue": "={{ $json.body.event }}", "rightValue": "ticket.created", "operator": { "type": "string", "operation": "equals" } }
          ]
        },
        "options": {}
      },
      "id": "a2s1-0002-tc-filter",
      "name": "Filter: ticket.created",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.DAYJOY_API_BASE_URL }}/api/tickets/{{ $json.body.data.id }}/auto-assign",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"category\": \"{{ $json.body.data.category }}\",\n  \"priority\": \"{{ $json.body.data.priority || 'NORMAL' }}\",\n  \"tenantId\": \"{{ $json.body.data.tenantId }}\",\n  \"strategy\": \"LEAST_WORKLOAD\",\n  \"triggeredBy\": \"n8n/ticket-creation\"\n}",
        "options": { "timeout": 10000 }
      },
      "id": "a2s1-0003-tc-autoassign",
      "name": "Auto-Assign: By Category+Workload",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 0],
      "credentials": { "httpHeaderAuth": { "id": "dayjoyApi", "name": "dayjoyApi" } },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.DAYJOY_API_BASE_URL }}/api/notifications/dispatch",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"channel\": \"EMAIL\",\n  \"event\": \"ticket_created_confirmation\",\n  \"ticketId\": \"{{ $('Filter: ticket.created').item.json.body.data.id }}\",\n  \"tenantId\": \"{{ $('Filter: ticket.created').item.json.body.data.tenantId }}\",\n  \"recipientEmail\": \"{{ $('Filter: ticket.created').item.json.body.data.customerEmail }}\",\n  \"template\": \"ticket-confirmation\",\n  \"metadata\": {\n    \"ticketNumber\": \"{{ $('Filter: ticket.created').item.json.body.data.ticketNumber || $('Filter: ticket.created').item.json.body.data.id }}\",\n    \"subject\": \"{{ $('Filter: ticket.created').item.json.body.data.subject }}\",\n    \"trackingUrl\": \"https://app.dayjoy.in/support/tickets/{{ $('Filter: ticket.created').item.json.body.data.id }}\",\n    \"workflow\": \"ticket-creation\"\n  }\n}",
        "options": { "timeout": 10000 }
      },
      "id": "a2s1-0004-tc-confirm-customer",
      "name": "Send: Customer Confirmation",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [660, 0],
      "credentials": { "httpHeaderAuth": { "id": "dayjoyApi", "name": "dayjoyApi" } },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.DAYJOY_API_BASE_URL }}/api/notifications/dispatch",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"channel\": \"MULTI\",\n  \"event\": \"ticket_assigned_notification\",\n  \"ticketId\": \"{{ $('Filter: ticket.created').item.json.body.data.id }}\",\n  \"tenantId\": \"{{ $('Filter: ticket.created').item.json.body.data.tenantId }}\",\n  \"assigneeId\": \"{{ $json.data.assigneeId || $json.assigneeId || $json.data.userId }}\",\n  \"template\": \"ticket-assignment\",\n  \"metadata\": {\n    \"ticketNumber\": \"{{ $('Filter: ticket.created').item.json.body.data.ticketNumber || $('Filter: ticket.created').item.json.body.data.id }}\",\n    \"subject\": \"{{ $('Filter: ticket.created').item.json.body.data.subject }}\",\n    \"priority\": \"{{ $('Filter: ticket.created').item.json.body.data.priority || 'NORMAL' }}\",\n    \"workflow\": \"ticket-creation\"\n  }\n}",
        "options": { "timeout": 10000 }
      },
      "id": "a2s1-0005-tc-notify-assignee",
      "name": "Send: Notify Assigned Employee",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [880, 0],
      "credentials": { "httpHeaderAuth": { "id": "dayjoyApi", "name": "dayjoyApi" } },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.DAYJOY_API_BASE_URL }}/api/tickets/{{ $('Filter: ticket.created').item.json.body.data.id }}/sla/start",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"priority\": \"{{ $('Filter: ticket.created').item.json.body.data.priority || 'NORMAL' }}\",\n  \"category\": \"{{ $('Filter: ticket.created').item.json.body.data.category }}\",\n  \"startedAt\": \"{{ $now.toISO() }}\",\n  \"startedBy\": \"n8n/ticket-creation\"\n}",
        "options": { "timeout": 10000 }
      },
      "id": "a2s1-0006-tc-sla",
      "name": "Start: SLA Timer",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1100, 0],
      "credentials": { "httpHeaderAuth": { "id": "dayjoyApi", "name": "dayjoyApi" } },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.DAYJOY_API_BASE_URL }}/api/ai/suggest-articles",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"query\": \"{{ $('Filter: ticket.created').item.json.body.data.subject }} {{ $('Filter: ticket.created').item.json.body.data.description }}\",\n  \"tenantId\": \"{{ $('Filter: ticket.created').item.json.body.data.tenantId }}\",\n  \"topK\": 3,\n  \"context\": { \"ticketId\": \"{{ $('Filter: ticket.created').item.json.body.data.id }}\", \"category\": \"{{ $('Filter: ticket.created').item.json.body.data.category }}\" }\n}",
        "options": { "timeout": 15000 }
      },
      "id": "a2s1-0007-tc-ai-suggest",
      "name": "AI: Suggest KB Articles",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1320, 0],
      "credentials": { "httpHeaderAuth": { "id": "dayjoyApi", "name": "dayjoyApi" } },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.DAYJOY_API_BASE_URL }}/api/tickets/{{ $('Filter: ticket.created').item.json.body.data.id }}/suggestions",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"type\": \"KB_ARTICLES\",\n  \"articles\": {{ JSON.stringify($json.data || $json.articles || []) }},\n  \"generatedAt\": \"{{ $now.toISO() }}\",\n  \"generatedBy\": \"n8n/ticket-creation\"\n}",
        "options": { "timeout": 10000 }
      },
      "id": "a2s1-0008-tc-save-suggest",
      "name": "Save: KB Suggestions on Ticket",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1540, 0],
      "credentials": { "httpHeaderAuth": { "id": "dayjoyApi", "name": "dayjoyApi" } },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.DAYJOY_API_BASE_URL }}/api/notifications/audit",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"channel\": \"SYSTEM\",\n  \"event\": \"ticket_creation_workflow_completed\",\n  \"ticketId\": \"{{ $('Filter: ticket.created').item.json.body.data.id }}\",\n  \"status\": \"SUCCESS\",\n  \"tenantId\": \"{{ $('Filter: ticket.created').item.json.body.data.tenantId }}\",\n  \"metadata\": {\n    \"workflow\": \"ticket-creation\",\n    \"assigneeId\": \"{{ $('Auto-Assign: By Category+Workload').item.json.data.assigneeId || $('Auto-Assign: By Category+Workload').item.json.assigneeId }}\",\n    \"steps\": [\"auto_assigned\", \"customer_confirmed\", \"assignee_notified\", \"sla_started\", \"ai_suggestions_saved\"]\n  }\n}",
        "options": { "timeout": 10000 }
      },
      "id": "a2s1-0009-tc-audit",
      "name": "Log: Audit Ticket Creation",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1760, 0],
      "credentials": { "httpHeaderAuth": { "id": "dayjoyApi", "name": "dayjoyApi" } },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    }
  ],
  "connections": {
    "Webhook: ticket.created": { "main": [ [ { "node": "Filter: ticket.created", "type": "main", "index": 0 } ] ] },
    "Filter: ticket.created": { "main": [ [ { "node": "Auto-Assign: By Category+Workload", "type": "main", "index": 0 } ] ] },
    "Auto-Assign: By Category+Workload": { "main": [ [ { "node": "Send: Customer Confirmation", "type": "main", "index": 0 } ] ] },
    "Send: Customer Confirmation": { "main": [ [ { "node": "Send: Notify Assigned Employee", "type": "main", "index": 0 } ] ] },
    "Send: Notify Assigned Employee": { "main": [ [ { "node": "Start: SLA Timer", "type": "main", "index": 0 } ] ] },
    "Start: SLA Timer": { "main": [ [ { "node": "AI: Suggest KB Articles", "type": "main", "index": 0 } ] ] },
    "AI: Suggest KB Articles": { "main": [ [ { "node": "Save: KB Suggestions on Ticket", "type": "main", "index": 0 } ] ] },
    "Save: KB Suggestions on Ticket": { "main": [ [ { "node": "Log: Audit Ticket Creation", "type": "main", "index": 0 } ] ] }
  },
  "settings": { "executionOrder": "v1", "saveExecutionProgress": true, "saveManualExecutions": true, "callerPolicy": "workflowsFromSameOwner" },
  "active": false,
  "tags": [{ "name": "support" }, { "name": "tickets" }, { "name": "sla" }, { "name": "ai" }, { "name": "dayjoy" }]
}
