{
  "name": "Dayjoy — Retry Strategy (Reusable Sub-Workflow)",
  "nodes": [
    {
      "parameters": {},
      "id": "3c4d5e6f-0001-4000-8000-000000000001",
      "name": "Execute Workflow Trigger",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [0, 0],
      "notes": "Called by other workflows with: { operation: { workflow_id, payload }, error: { message, code, stack, http_status }, context: { source_execution_id, attempt } }. Returns { action, attempts_made, final_status, last_error }."
    },
    {
      "parameters": {
        "jsCode": "// Classify the error into a retry-strategy bucket.\n// Strategies:\n//   - network      -> retry 3x, exponential backoff (1s, 2s, 4s)\n//   - rate_limit   -> retry once after 60s fixed delay\n//   - validation   -> DO NOT retry (route to DLQ)\n//   - auth         -> refresh token then retry once\n//   - server_error -> retry 2x with 10s backoff\n//   - unknown      -> do not retry (route to DLQ)\n\nconst e = $json.error || {};\nconst msg = (e.message || '').toLowerCase();\nconst code = (e.code || '').toString().toLowerCase();\nconst status = Number(e.http_status) || 0;\nconst combined = `${msg} ${code} ${status}`;\n\nlet strategy = 'dlq';\nlet max_attempts = 0;\nlet backoff_ms = 0;\nlet backoff_pattern = [];\nlet description = 'No retry — route to dead-letter queue.';\n\nif (\n  combined.includes('etimedout') ||\n  combined.includes('econnreset') ||\n  combined.includes('econnrefused') ||\n  combined.includes('enotfound') ||\n  combined.includes('socket hang up') ||\n  combined.includes('timeout') ||\n  combined.includes('network')\n) {\n  strategy = 'network';\n  max_attempts = 3;\n  backoff_pattern = [1000, 2000, 4000];\n  backoff_ms = 1000;\n  description = 'Network error — exponential backoff (1s, 2s, 4s), up to 3 attempts.';\n} else if (status === 429 || combined.includes('rate limit') || combined.includes('too many requests')) {\n  strategy = 'rate_limit';\n  max_attempts = 1;\n  backoff_pattern = [60000];\n  backoff_ms = 60000;\n  description = 'Rate limited — single retry after 60s fixed delay.';\n} else if (\n  combined.includes('validation') ||\n  combined.includes('schema') ||\n  combined.includes('required field') ||\n  combined.includes('invalid input') ||\n  status === 400 ||\n  status === 422\n) {\n  strategy = 'dlq';\n  max_attempts = 0;\n  description = 'Validation error — will NOT retry. Routing to dead-letter queue.';\n} else if (\n  status === 401 ||\n  status === 403 ||\n  combined.includes('unauthorized') ||\n  combined.includes('forbidden') ||\n  combined.includes('token expired') ||\n  combined.includes('invalid_grant')\n) {\n  strategy = 'auth';\n  max_attempts = 1;\n  backoff_pattern = [2000];\n  backoff_ms = 2000;\n  description = 'Auth error — refresh token, then a single retry.';\n} else if (status >= 500 || combined.includes('internal server error') || combined.includes('bad gateway')) {\n  strategy = 'server_error';\n  max_attempts = 2;\n  backoff_pattern = [10000, 10000];\n  backoff_ms = 10000;\n  description = 'Server error — 2 retries with 10s fixed backoff.';\n}\n\nreturn {\n  json: {\n    ...$json,\n    retry_strategy: strategy,\n    max_attempts,\n    backoff_ms,\n    backoff_pattern,\n    description,\n    classified_at: new Date().toISOString()\n  }\n};\n"
      },
      "id": "3c4d5e6f-0001-4000-8000-000000000002",
      "name": "Classify Error Type",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [240, 0]
    },
