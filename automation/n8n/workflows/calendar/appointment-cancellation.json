{
  "name": "Calendar — Appointment Cancellation",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "calendar/appointment-cancellation",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "a2c3-0001-cancel-webhook",
      "name": "Webhook: appointment.cancelled",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "webhookId": "a2c3-cancel-webhook-id"
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "combinator": "and",
          "conditions": [
            { "id": "cond-event", "leftValue": "={{ $json.body.event }}", "rightValue": "appointment.cancelled", "operator": { "type": "string", "operation": "equals" } }
          ]
        },
        "options": {}
      },
      "id": "a2c3-0002-cancel-filter",
      "name": "Filter: appointment.cancelled",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.DAYJOY_API_BASE_URL }}/api/appointments/{{ $json.body.data.id }}/external-ref",
        "options": { "timeout": 10000 }
      },
      "id": "a2c3-0003-cancel-fetch-ref",
      "name": "Fetch: External GCal Ref",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 0],
      "credentials": { "httpHeaderAuth": { "id": "dayjoyApi", "name": "dayjoyApi" } },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    },
    {
      "parameters": {
        "calendarId": { "__rl": true, "value": "={{ $json.data.externalCalendarId || $json.data.employeeEmail || 'primary' }}", "mode": "id" },
        "eventId": { "__rl": true, "value": "={{ $json.data.externalEventId }}", "mode": "id" },
        "sendUpdates": true,
        "additionalFields": {}
      },
      "id": "a2c3-0004-cancel-gcal",
      "name": "GCal: Cancel Event",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1,
      "position": [660, 0],
      "credentials": { "googleCalendarOAuth2Api": { "id": "googleCalendar", "name": "googleCalendar" } },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.DAYJOY_API_BASE_URL }}/api/notifications/dispatch",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"channel\": \"MULTI\",\n  \"event\": \"appointment_cancelled\",\n  \"appointmentId\": \"{{ $('Filter: appointment.cancelled').item.json.body.data.id }}\",\n  \"recipientEmail\": \"{{ $('Filter: appointment.cancelled').item.json.body.data.customerEmail }}\",\n  \"recipientPhone\": \"{{ $('Filter: appointment.cancelled').item.json.body.data.customerPhone }}\",\n  \"tenantId\": \"{{ $('Filter: appointment.cancelled').item.json.body.data.tenantId }}\",\n  \"template\": \"appointment-cancellation\",\n  \"metadata\": {\n    \"reason\": \"{{ $('Filter: appointment.cancelled').item.json.body.data.reason || 'Customer request' }}\",\n    \"rescheduleUrl\": \"https://app.dayjoy.in/appointments/{{ $('Filter: appointment.cancelled').item.json.body.data.id }}/reschedule\",\n    \"workflow\": \"appointment-cancellation\"\n  }\n}",
        "options": { "timeout": 10000 }
      },
      "id": "a2c3-0005-cancel-notify",
      "name": "Dispatch: Notify + Offer Reschedule",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [880, 0],
      "credentials": { "httpHeaderAuth": { "id": "dayjoyApi", "name": "dayjoyApi" } },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.DAYJOY_API_BASE_URL }}/api/crm/interactions",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"entityType\": \"CUSTOMER\",\n  \"entityId\": \"{{ $('Filter: appointment.cancelled').item.json.body.data.customerId }}\",\n  \"type\": \"APPOINTMENT_CANCELLED\",\n  \"subject\": \"Appointment cancelled\",\n  \"description\": \"Appointment {{ $('Filter: appointment.cancelled').item.json.body.data.id }} cancelled — reason: {{ $('Filter: appointment.cancelled').item.json.body.data.reason || 'customer request' }}\",\n  \"tenantId\": \"{{ $('Filter: appointment.cancelled').item.json.body.data.tenantId }}\",\n  \"metadata\": { \"workflow\": \"appointment-cancellation\", \"appointmentId\": \"{{ $('Filter: appointment.cancelled').item.json.body.data.id }}\" }\n}",
        "options": { "timeout": 10000 }
      },
      "id": "a2c3-0006-cancel-crm",
      "name": "Update: CRM Interaction Record",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1100, 0],
      "credentials": { "httpHeaderAuth": { "id": "dayjoyApi", "name": "dayjoyApi" } },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.DAYJOY_API_BASE_URL }}/api/notifications/audit",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"channel\": \"CALENDAR\",\n  \"event\": \"google_calendar_event_cancelled\",\n  \"appointmentId\": \"{{ $('Filter: appointment.cancelled').item.json.body.data.id }}\",\n  \"status\": \"SUCCESS\",\n  \"tenantId\": \"{{ $('Filter: appointment.cancelled').item.json.body.data.tenantId }}\",\n  \"metadata\": { \"workflow\": \"appointment-cancellation\" }\n}",
        "options": { "timeout": 10000 }
      },
      "id": "a2c3-0007-cancel-audit",
      "name": "Log: Audit Cancellation",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1320, 0],
      "credentials": { "httpHeaderAuth": { "id": "dayjoyApi", "name": "dayjoyApi" } },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    }
  ],
  "connections": {
    "Webhook: appointment.cancelled": { "main": [ [ { "node": "Filter: appointment.cancelled", "type": "main", "index": 0 } ] ] },
    "Filter: appointment.cancelled": { "main": [ [ { "node": "Fetch: External GCal Ref", "type": "main", "index": 0 } ] ] },
    "Fetch: External GCal Ref": { "main": [ [ { "node": "GCal: Cancel Event", "type": "main", "index": 0 } ] ] },
    "GCal: Cancel Event": { "main": [ [ { "node": "Dispatch: Notify + Offer Reschedule", "type": "main", "index": 0 } ] ] },
    "Dispatch: Notify + Offer Reschedule": { "main": [ [ { "node": "Update: CRM Interaction Record", "type": "main", "index": 0 } ] ] },
    "Update: CRM Interaction Record": { "main": [ [ { "node": "Log: Audit Cancellation", "type": "main", "index": 0 } ] ] }
  },
  "settings": { "executionOrder": "v1", "saveExecutionProgress": true, "saveManualExecutions": true, "callerPolicy": "workflowsFromSameOwner" },
  "active": false,
  "tags": [{ "name": "calendar" }, { "name": "appointment" }, { "name": "google" }, { "name": "dayjoy" }]
}
