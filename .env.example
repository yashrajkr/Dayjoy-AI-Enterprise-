# =====================================================
# Dayjoy AI Enterprise — Environment Variables
# =====================================================
# Copy this file to `.env` and fill in your values:
#   cp .env.example .env
#
# Secrets should NEVER be committed. In production, inject secrets via
# AWS Secrets Manager + External Secrets Operator (see
# deployment/kubernetes/03-external-secrets.yaml).
#
# Generate strong secrets with:
#   openssl rand -hex 32
#
# Legend:
#   [REQUIRED]      App will not start without this.
#   [REQUIRED-PROD] Required in production; optional in dev.
#   [OPTIONAL]      Has a sensible default.
#   [CHANNEL]       Required only if you use that AI channel.

# =====================================================
# App / Runtime  (REQUIRED)
# =====================================================
# Application environment — affects logging verbosity, error details, etc.
NODE_ENV=development
# Port the NestJS backend listens on.
PORT=3000
# Public base URL of the backend (used in emails, webhooks, OpenAPI server URL).
APP_URL=http://localhost:3000
# Semantic version — surfaced in /health and Swagger.
APP_VERSION=1.0.0
# Comma-separated list of allowed CORS origins (takes precedence over CORS_ORIGIN).
# Example: https://admin.dayjoy.ai,https://customer.dayjoy.ai
CORS_ORIGINS=
# Single allowed CORS origin (used when CORS_ORIGINS is empty).
CORS_ORIGIN=http://localhost:3003
# Max upload size in bytes (default 10 MB).
UPLOAD_MAX_SIZE=10485760
# Default tenant ID for multi-tenant routing (set to the seeded tenant UUID).
DEFAULT_TENANT_ID=
# Winston log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# =====================================================
# Database (REQUIRED)
# =====================================================
# PostgreSQL connection string. MUST have pgvector extension enabled.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DB
DATABASE_URL=postgresql://dayjoy:dayjoy@localhost:5432/dayjoy_ai
# Prisma connection pool size.
DATABASE_POOL_SIZE=20
# Connection timeout (ms).
DATABASE_CONNECTION_TIMEOUT=30000

# =====================================================
# Redis (REQUIRED)
# =====================================================
# Redis connection string. Used for cache, sessions, rate-limit state, JWT blocklist.
REDIS_URL=redis://localhost:6379
# Optional Redis password (set if your Redis requires AUTH).
REDIS_PASSWORD=

# =====================================================
# JWT / Auth (REQUIRED)
# =====================================================
# JWT signing secret — minimum 32 characters.
# Generate: openssl rand -hex 32
JWT_SECRET=replace-with-min-32-char-secret-key-in-production
# Access token lifetime (default 1h).
JWT_EXPIRES_IN=1h
# Refresh token lifetime (default 7d).
JWT_REFRESH_EXPIRES_IN=7d
# Session cookie signing secret — minimum 32 characters.
# Generate: openssl rand -hex 32
SESSION_SECRET=replace-with-min-32-char-session-secret
# bcrypt cost factor (default 12; lower for dev, higher for prod).
BCRYPT_ROUNDS=12

# =====================================================
# AWS  (REQUIRED-PROD — used by External Secrets Operator + S3)
# =====================================================
AWS_REGION=ap-south-1
# Secrets Manager secret ID containing all prod secrets (synced to K8s secrets).
AWS_SECRET_MANAGER_SECRET_ID=dayjoy/prod

# =====================================================
# OpenAI / LLM  (REQUIRED for AI features)
# =====================================================
# OpenAI API key for chat completions + embeddings.
OPENAI_API_KEY=
# Chat model (default gpt-4; gpt-4o recommended).
OPENAI_MODEL=gpt-4o
# Embedding model (default text-embedding-3-small, 1536 dims).
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Embedding vector dimensions (must match the pgvector column size).
OPENAI_EMBEDDING_DIMENSIONS=1536
# Optional: alternate OpenAI-compatible base URL (Azure, proxy, LiteLLM).
OPENAI_API_BASE=
# Optional: API version (Azure OpenAI).
OPENAI_API_VERSION=

# --- Alternative LLM providers (OPTIONAL — used by rag/response-pipeline) ---
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# --- Azure OpenAI (OPTIONAL) ---
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_BASE=
AZURE_OPENAI_API_VERSION=
AZURE_EMBEDDING_DEPLOYMENT_NAME=

# --- Local / self-hosted embeddings (OPTIONAL) ---
LOCAL_EMBEDDING_API_BASE=
LOCAL_EMBEDDING_MODEL=

# =====================================================
# Vapi — Voice AI  (CHANNEL — required if using voice)
# =====================================================
# Vapi REST API key (from dashboard).
# SECURITY NOTE: never commit a real key here. Set your key only in backend/.env.
VAPI_API_KEY="d5701174-8c50-4518-9f5f-6a27b8bee14f"
# Webhook signing secret — used to verify incoming Vapi webhooks.
# Generate: openssl rand -hex 32
VAPI_WEBHOOK_SECRET=
# Public URL Vapi will call for webhook events.
VAPI_WEBHOOK_URL=https://api.dayjoy.ai/api/voice/webhook
# Existing assistant ID to reuse (skip creating a new one on startup).
VAPI_ASSISTANT_ID=
# Vapi REST API base URL (override only for self-hosted).
VAPI_API_BASE_URL=https://api.vapi.ai
# Display name for the assistant (created if VAPI_ASSISTANT_ID is unset).
VAPI_ASSISTANT_NAME=Dayjoy AI Assistant
# 11Labs voice ID.
VAPI_VOICE_ID=rachel
# Voice tuning (0.0–1.0).
VAPI_VOICE_STABILITY=0.5
VAPI_VOICE_SIMILARITY_BOOST=0.75
VAPI_VOICE_SPEED=1.0
# LLM used inside Vapi assistant.
VAPI_MODEL=gpt-4o
VAPI_TEMPERATURE=0.7
VAPI_MAX_TOKENS=1000
# Transcription provider (deepgram | assemblyai).
VAPI_TRANSCRIPTION_MODEL=nova-2
VAPI_LANGUAGE=en-US
# Call behaviour (seconds).
VAPI_SILENCE_TIMEOUT=30
VAPI_RESPONSE_DELAY=0.4
VAPI_CALL_MAX_DURATION=1800
# Feature toggles — set to "false" to disable.
VAPI_RECORDING_ENABLED=true
VAPI_TRANSCRIPTION_ENABLED=true
# Tenant ID assigned to inbound Vapi calls when one can't be resolved.
VAPI_DEFAULT_TENANT_ID=
# Phone number ID purchased in Vapi dashboard (for outbound calls).
VAPI_PHONE_NUMBER_ID=

# =====================================================
# WhatsApp Business API  (CHANNEL — required if using WhatsApp)
# =====================================================
# Meta Cloud API access token (System User token, permanent).
WHATSAPP_TOKEN=
# Phone Number ID from Meta App dashboard.
WHATSAPP_PHONE_NUMBER_ID=
# WhatsApp Business Account ID.
WHATSAPP_BUSINESS_ACCOUNT_ID=
# App Secret from Meta App dashboard — used to verify X-Hub-Signature-256 HMAC.
WHATSAPP_APP_SECRET=
# Verify token for the initial Meta webhook subscription handshake.
# Generate: openssl rand -hex 16
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Additional webhook signing secret (defense-in-depth).
# Generate: openssl rand -hex 32
WHATSAPP_WEBHOOK_SECRET=

# =====================================================
# Twilio — Telephony fallback  (CHANNEL — required for SMS/voice fallback)
# =====================================================
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Public URL Twilio will call for status callbacks.
TWILIO_WEBHOOK_URL=

# =====================================================
# Email — SMTP  (CHANNEL — required for transactional email)
# =====================================================
# SMTP host (SendGrid: smtp.sendgrid.net; SES: email-smtp.<region>.amazonaws.com).
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
# SendGrid uses "apikey" as the username; SES uses IAM SMTP credentials.
SMTP_USER=apikey
SMTP_PASSWORD=
SMTP_FROM=no-reply@dayjoy.ai

# =====================================================
# Stripe — Payments  (OPTIONAL)
# =====================================================
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_CLIENT_ID=

# =====================================================
# Razorpay — India Payments  (OPTIONAL)
# =====================================================
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# =====================================================
# File Storage — S3  (REQUIRED-PROD for file uploads)
# =====================================================
S3_BUCKET=dayjoy-ai-uploads
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# =====================================================
# Vector DB — alternative to pgvector  (OPTIONAL)
# =====================================================
# Qdrant URL (when VECTOR_DB_PROVIDER=qdrant).
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# =====================================================
# Monitoring / APM  (OPTIONAL)
# =====================================================
APM_ENABLED=false
SENTRY_DSN=
DATADOG_API_KEY=

# =====================================================
# Feature Flags  (OPTIONAL — defaults shown)
# =====================================================
FEATURE_VOICE_RECORDING=true
FEATURE_TRANSCRIPTION=true
FEATURE_SENTIMENT_ANALYSIS=true
FEATURE_HUMAN_TRANSFER=true
FEATURE_AI_EVALUATION=false
FEATURE_WHATSAPP_BOT=false

# =====================================================
# Rate Limiting  (OPTIONAL — defaults shown)
# =====================================================
# Auth endpoints (login, register, password reset).
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=10
# Generic API endpoints.
RATE_LIMIT_API_WINDOW_MS=60000
RATE_LIMIT_API_MAX=100

# =====================================================
# Frontend — public vars exposed to the browser
# (Each portal also has its own .env.local overriding these.)
# =====================================================
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_VOICE_WIDGET_URL=
NEXT_PUBLIC_WHATSAPP_NUMBER=

# =====================================================
# Backups  (OPTIONAL)
# =====================================================
BACKUP_S3_BUCKET=dayjoy-ai-backups
# Cron schedule (default: daily at 02:00 UTC).
BACKUP_SCHEDULE=0 2 * * *

# =====================================================
# Encryption  (REQUIRED-PROD)
# =====================================================
# 32-byte hex key used for field-level encryption (PII, API keys at rest).
# Generate: openssl rand -hex 32
ENCRYPTION_KEY=replace-with-32-byte-hex-key
