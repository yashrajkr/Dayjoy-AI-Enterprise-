{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "description": "Expected RAG queries and answers used by the evaluation / integration test suites. Each entry pairs a natural-language query with the substrings the response MUST contain (precision of recall) and the substrings the response MUST NOT contain (hallucination guard). The 'relevantSection' hint tells the test which fixture section the retrieved chunks should come from.",
  "queries": [
    {
      "id": "q-001",
      "queryText": "What is the recommended dosage of Dayjoy Premium Health Tonic?",
      "expectedContains": [
        "15 ml",
        "twice daily",
        "after meals"
      ],
      "mustNotContain": [
        "before meals",
        "once daily"
      ],
      "feedback": "positive",
      "relevantSection": "SECTION 1: Dayjoy Premium Health Tonic",
      "expectedCitationCount": 1
    },
    {
      "id": "q-002",
      "queryText": "What are the key ingredients in Dayjoy Premium Health Tonic?",
      "expectedContains": [
        "Ashwagandha",
        "Shatavari",
        "Amla",
        "Giloy"
      ],
      "mustNotContain": [
        "turmeric",
        "ginger"
      ],
      "feedback": "positive",
      "relevantSection": "SECTION 1: Dayjoy Premium Health Tonic",
      "expectedCitationCount": 1
    },
    {
      "id": "q-003",
      "queryText": "What is the MRP of Dayjoy Premium Health Tonic?",
      "expectedContains": [
        "699",
        "500 ml"
      ],
      "mustNotContain": [
        "Rs. 999",
        "Rs. 499"
      ],
      "feedback": "positive",
      "relevantSection": "SECTION 1: Dayjoy Premium Health Tonic",
      "expectedCitationCount": 1
    },
    {
