      ],
      "feedback": "positive",
      "relevantSection": "SECTION 2: Distributor Onboarding",
      "expectedCitationCount": 1
    },
    {
      "id": "q-005",
      "queryText": "How is the distributor commission calculated?",
      "expectedContains": [
