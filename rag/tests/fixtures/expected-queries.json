      "relevantSection": "FAQ Section 2: Returns and Refunds",
      "expectedCitationCount": 1
    },
    {
      "id": "q-008",
      "queryText": "How long does it take to get a refund?",
      "expectedContains": [
        "5-7 business days",
        "UPI"
      ],
      "mustNotContain": [
        "instant",
        "same day"
      ],
      "feedback": "positive",
      "relevantSection": "FAQ Section 2: Returns and Refunds",
      "expectedCitationCount": 1
    },
    {
      "id": "q-009",
