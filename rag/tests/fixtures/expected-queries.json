        "weekly",
        "daily payout"
      ],
      "feedback": "positive",
      "relevantSection": "SECTION 3: Compensation Plan",
      "expectedCitationCount": 1
    },
    {
      "id": "q-006",
      "queryText": "When is the distributor commission credited?",
      "expectedContains": [
        "10th",
        "monthly"
      ],
      "mustNotContain": [
        "weekly",
        "15th"
      ],
      "feedback": "positive",
      "relevantSection": "SECTION 3: Compensation Plan",
      "expectedCitationCount": 1
