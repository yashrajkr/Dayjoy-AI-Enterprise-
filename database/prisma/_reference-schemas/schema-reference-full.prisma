// Dayjoy Enterprise AI Platform - Prisma Schema
// PostgreSQL + Prisma ORM

// 1. Datasource & Generator

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// 2. Enums

enum TenantStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  DELETED
}

enum CustomerType {
  INDIVIDUAL
  BUSINESS
}

enum DistributorStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  DELETED
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  DELETED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED
  LOST
  DELETED
}

enum InteractionType {
  CALL
  EMAIL
  MEETING
  MESSAGE
  NOTE
  OTHER
}

enum WorkflowType {
  BUSINESS
  AI
  INTEGRATION
  NOTIFICATION
}

enum WorkflowStatus {
  ACTIVE
  INACTIVE
  DRAFT
  ARCHIVED
}

enum ExecutionStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum NotificationType {
  EMAIL
  SMS
  WHATSAPP
  PUSH
  IN_APP
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum NotificationStatus {
  PENDING
  SENDING
  SENT
  FAILED
  CANCELLED
}

enum ChannelType {
  VOICE
  WHATSAPP
  WEB
  API
}

enum AgentType {
  SUPPORT
  SALES
  ONBOARDING
  TECHNICAL
  BILLING
  DISTRIBUTOR
  ADMIN
  VOICE
  WHATSAPP
  WEB
}

enum MemoryType {
  FACT
  PREFERENCE
  HISTORY
  CONTEXT
}

enum MetricType {
  COUNT
  SUM
  AVERAGE
  PERCENTAGE
  RATIO
}

enum MetricUnit {
  NUMBER
  PERCENT
  CURRENCY
  DURATION
}

enum AuditAction {
  INSERT
  UPDATE
  DELETE
}

// 3. Core Models

model Tenant {
  id         String        @id @default(uuid())
  name       String
  slug       String        @unique
  status     TenantStatus  @default(ACTIVE)
  settings   Json?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  users        User[]
  roles        Role[]
  customers    Customer[]
  distributors Distributor[]
  products     Product[]
  orders       Order[]
  leads        Lead[]
  agents       AiAgent[]
  ragSources   RagSource[]
  notifications Notification[]
  workflows    Workflow[]
  metrics      Metric[]
  auditLogs    AuditLog[]

  @@map("tenants")
}

model User {
  id           String       @id @default(uuid())
  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  tenantId     String
  email        String       @unique
  passwordHash String?
  phone        String?
  firstName    String?
  lastName     String?
  status       UserStatus   @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  sessions   UserSession[]
  userRoles  UserRole[]
  customers  Customer[]
  distributors Distributor[]
  employeeProfiles EmployeeProfile[]
  interactions Interaction[]
  followUps   FollowUp[]
  workflowExecutions WorkflowExecution[] @relation("ExecutionCreatedBy")
  auditLogs  AuditLog[]

  @@map("users")
}

model UserSession {
  id         String   @id @default(uuid())
  user       User     @relation(fields: [userId], references: [id])
  userId     String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  tenantId   String
  tokenHash  String   @unique
  ipAddress  String?
  userAgent  String?
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@map("user_sessions")
}

model Role {
  id        String   @id @default(uuid())
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  tenantId  String
  name      String
  description String?
  isSystem  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@unique([tenantId, name])
  @@map("roles")
}

model Permission {
  id          String @id @default(uuid())
  resource    String
  action      String
  description String?
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]

  @@unique([resource, action])
  @@map("permissions")
}

model RolePermission {
  role        Role       @relation(fields: [roleId], references: [id])
  roleId      String
  permission  Permission @relation(fields: [permissionId], references: [id])
  permissionId String
  createdAt   DateTime   @default(now())

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  user       User   @relation(fields: [userId], references: [id])
  userId     String
  role       Role   @relation(fields: [roleId], references: [id])
  roleId     String
  tenant     Tenant @relation(fields: [tenantId], references: [id])
  tenantId   String
  assignedBy String?
  assignedAt DateTime @default(now())
  expiresAt  DateTime?

  @@id([userId, roleId])
  @@map("user_roles")
}

// 4. Business Models

model Customer {
  id          String        @id @default(uuid())
  tenant      Tenant        @relation(fields: [tenantId], references: [id])
  tenantId    String
  user        User?         @relation(fields: [userId], references: [id])
  userId      String?
  customerType CustomerType @default(INDIVIDUAL)
  companyName String?
  firstName   String?
  lastName    String?
  email       String?
  phone       String?
  address     Json?
  status      String        @default("active")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  orders      Order[]
  interactions Interaction[]

  @@map("customers")
}

model Distributor {
  id             String            @id @default(uuid())
  tenant         Tenant            @relation(fields: [tenantId], references: [id])
  tenantId       String
  user           User?             @relation(fields: [userId], references: [id])
  userId         String?
  distributorCode String           @unique
  companyName    String
  contactPerson  String?
  email          String
  phone          String?
  address        Json?
  commissionRate Float?
  status         DistributorStatus @default(ACTIVE)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  orders         Order[]

  @@map("distributors")
}

model ProductCategory {
  id        String   @id @default(uuid())
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  tenantId  String
  parent    ProductCategory? @relation("CategoryChildren", fields: [parentId], references: [id])
  parentId  String?
  name      String
  slug      String
  description String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  children  ProductCategory[] @relation("CategoryChildren")
  products  Product[]

  @@unique([tenantId, slug])
  @@map("product_categories")
}

model Product {
  id             String        @id @default(uuid())
  tenant         Tenant        @relation(fields: [tenantId], references: [id])
  tenantId       String
  category       ProductCategory? @relation(fields: [categoryId], references: [id])
  categoryId     String?
  sku            String
  name           String
  description    String?
  price          Float
  cost           Float?
  currency       String        @default("USD")
  inventoryCount Int           @default(0)
  attributes     Json?
  images         Json?
  status         ProductStatus @default(ACTIVE)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  orderItems     OrderItem[]

  @@unique([tenantId, sku])
  @@map("products")
}

model Order {
  id           String      @id @default(uuid())
  tenant       Tenant      @relation(fields: [tenantId], references: [id])
  tenantId     String
  customer     Customer    @relation(fields: [customerId], references: [id])
  customerId   String
  distributor  Distributor? @relation(fields: [distributorId], references: [id])
  distributorId String?
  orderNumber  String      @unique
  status       OrderStatus @default(PENDING)
  subtotal     Float       @default(0)
  tax          Float?      @default(0)
  shipping     Float?      @default(0)
  discount     Float?      @default(0)
  total        Float       @default(0)
  currency     String      @default("USD")
  shippingAddress Json?
  billingAddress Json?
  metadata     Json?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  items        OrderItem[]

  @@map("orders")
}

model OrderItem {
  id        String  @id @default(uuid())
  order     Order   @relation(fields: [orderId], references: [id])
  orderId   String
  product   Product @relation(fields: [productId], references: [id])
  productId String
  quantity  Int     @default(1)
  unitPrice Float   @default(0)
  subtotal  Float   @default(0)
  tax       Float?  @default(0)
  discount  Float?  @default(0)
  total     Float   @default(0)

  @@map("order_items")
}

model Lead {
  id          String     @id @default(uuid())
  tenant      Tenant     @relation(fields: [tenantId], references: [id])
  tenantId    String
  sourceId    String?
  assignedTo  User?      @relation(fields: [assignedToId], references: [id])
  assignedToId String?
  firstName   String?
  lastName    String?
  email       String?
  phone       String?
  company     String?
  status      LeadStatus @default(NEW)
  score       Int        @default(0)
  metadata    Json?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  interactions Interaction[]
  followUps    FollowUp[]

  @@map("leads")
}

model Interaction {
  id          String          @id @default(uuid())
  tenant      Tenant          @relation(fields: [tenantId], references: [id])
  tenantId    String
  customer    Customer?       @relation(fields: [customerId], references: [id])
  customerId  String?
  lead        Lead?           @relation(fields: [leadId], references: [id])
  leadId      String?
  user        User            @relation(fields: [userId], references: [id])
  userId      String
  type        InteractionType
  subject     String?
  description String?
  outcome     String?
  followUpRequired Boolean    @default(false)
  followUpDate DateTime?
  metadata    Json?
  createdAt   DateTime        @default(now())

  @@map("interactions")
}

model FollowUp {
  id          String          @id @default(uuid())
  tenant      Tenant          @relation(fields: [tenantId], references: [id])
  tenantId    String
  interaction Interaction?    @relation(fields: [interactionId], references: [id])
  interactionId String?
  assignedTo  User            @relation(fields: [assignedToId], references: [id])
  assignedToId String
  customer    Customer?       @relation(fields: [customerId], references: [id])
  customerId  String?
  lead        Lead?           @relation(fields: [leadId], references: [id])
  leadId      String?
  type        InteractionType
  subject     String
  description String?
  status      String          @default("pending")
  dueDate     DateTime
  completedAt DateTime?
  metadata    Json?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@map("follow_ups")
}

// 5. AI Models

model AiAgent {
  id           String    @id @default(uuid())
  tenant       Tenant    @relation(fields: [tenantId], references: [id])
  tenantId     String
  name         String
  type         AgentType
  description  String?
  configuration Json?
  capabilities Json?
  status       String    @default("active")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  conversations Conversation[]

  @@map("ai_agents")
}

model Conversation {
  id           String      @id @default(uuid())
  tenant       Tenant      @relation(fields: [tenantId], references: [id])
  tenantId     String
  agent        AiAgent     @relation(fields: [agentId], references: [id])
  agentId      String
  user         User?       @relation(fields: [userId], references: [id])
  userId       String?
  customer     Customer?   @relation(fields: [customerId], references: [id])
  customerId   String?
  channel      ChannelType
  sessionId    String?
  status       String      @default("active")
  context      Json?
  metadata     Json?
  startedAt    DateTime    @default(now())
  endedAt      DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  messages     Message[]

  @@map("conversations")
}

model Message {
  id           String       @id @default(uuid())
  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  tenantId     String
  conversation Conversation  @relation(fields: [conversationId], references: [id])
  conversationId String
  role         String       // user, assistant, system
  content      String
  contentType  String       // text, markdown, audio, image
  metadata     Json?
  tokensUsed   Int?
  createdAt    DateTime     @default(now())

  @@map("messages")
}

model AiMemory {
  id          String     @id @default(uuid())
  tenant      Tenant     @relation(fields: [tenantId], references: [id])
  tenantId    String
  user        User?      @relation(fields: [userId], references: [id])
  userId      String?
  customer    Customer?  @relation(fields: [customerId], references: [id])
  customerId  String?
  type        MemoryType
  key         String
  value       String
  importance  Int        @default(5)
  expiresAt   DateTime?
  metadata    Json?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("ai_memory")
}

model RagSource {
  id          String   @id @default(uuid())
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  tenantId    String
  name        String
  type        String   // document, website, database, api, manual
  description String?
  configuration Json?
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  documents   RagDocument[]

  @@map("rag_sources")
}

model RagDocument {
  id          String    @id @default(uuid())
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  tenantId    String
  source      RagSource @relation(fields: [sourceId], references: [id])
  sourceId    String
  title       String
  content     String?
  metadata    Json?
  wordCount   Int?
  status      String    @default("processed")
  processedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  chunks      RagChunk[]

  @@map("rag_documents")
}

model RagChunk {
  id          String      @id @default(uuid())
  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  tenantId    String
  document    RagDocument @relation(fields: [documentId], references: [id])
  documentId  String
  chunkIndex  Int
  content     String
  embedding   Bytes?
  metadata    Json?
  createdAt   DateTime    @default(now())

  @@map("rag_chunks")
}

model Embedding {
  id          String   @id @default(uuid())
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  tenantId    String
  entityType  String
  entityId    String
  embedding   Bytes
  metadata    Json?
  createdAt   DateTime @default(now())

  @@map("embeddings")
}

// 6. Channels Models

model VoiceSession {
  id           String        @id @default(uuid())
  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  tenantId     String
  conversation Conversation?  @relation(fields: [conversationId], references: [id])
  conversationId String?
  callId       String        @unique
  phoneNumber  String?
  status       String        @default("active")
  durationSeconds Int?
  recordingUrl String?
  metadata     Json?
  startedAt    DateTime      @default(now())
  endedAt      DateTime?
  createdAt    DateTime      @default(now())

  recordings   VoiceRecording[]

  @@map("voice_sessions")
}

model VoiceRecording {
  id            String      @id @default(uuid())
  tenant        Tenant      @relation(fields: [tenantId], references: [id])
  tenantId      String
  session       VoiceSession @relation(fields: [sessionId], references: [id])
  sessionId     String
  recordingUrl  String
  durationSeconds Int?
  fileSizeBytes Int?
  format        String?
  transcription String?
  metadata      Json?
  createdAt     DateTime    @default(now())

  @@map("voice_recordings")
}

model WhatsappContact {
  id          String    @id @default(uuid())
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  tenantId    String
  customer    Customer? @relation(fields: [customerId], references: [id])
  customerId  String?
  phoneNumber String    @unique
  name        String?
  profilePictureUrl String?
  status      String    @default("active")
  metadata    Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  sessions    WhatsappSession[]

  @@map("whatsapp_contacts")
}

model WhatsappSession {
  id          String          @id @default(uuid())
  tenant      Tenant          @relation(fields: [tenantId], references: [id])
  tenantId    String
  contact     WhatsappContact @relation(fields: [contactId], references: [id])
  contactId   String
  conversation Conversation?  @relation(fields: [conversationId], references: [id])
  conversationId String?
  sessionId   String          @unique
  status      String          @default("active")
  metadata    Json?
  startedAt   DateTime        @default(now())
  endedAt     DateTime?
  createdAt   DateTime        @default(now())

  messages    WhatsappMessage[]

  @@map("whatsapp_sessions")
}

model WhatsappMessage {
  id          String          @id @default(uuid())
  tenant      Tenant          @relation(fields: [tenantId], references: [id])
  tenantId    String
  session     WhatsappSession @relation(fields: [sessionId], references: [id])
  sessionId   String
  contact     WhatsappContact @relation(fields: [contactId], references: [id])
  contactId   String
  conversation Conversation?  @relation(fields: [conversationId], references: [id])
  conversationId String?
  messageId   String          @unique
  direction   String          // inbound, outbound
  type        String          // text, image, audio, etc.
  content     String?
  mediaUrl    String?
  status      String          @default("sent")
  metadata    Json?
  createdAt   DateTime        @default(now())

  @@map("whatsapp_messages")
}

model WebSession {
  id          String        @id @default(uuid())
  tenant      Tenant        @relation(fields: [tenantId], references: [id])
  tenantId    String
  conversation Conversation? @relation(fields: [conversationId], references: [id])
  conversationId String?
  sessionId   String        @unique
  user        User?         @relation(fields: [userId], references: [id])
  userId      String?
  customer    Customer?     @relation(fields: [customerId], references: [id])
  customerId  String?
  ipAddress   String?
  userAgent   String?
  referrer    String?
  landingPage String?
  status      String        @default("active")
  metadata    Json?
  startedAt   DateTime      @default(now())
  endedAt     DateTime?
  createdAt   DateTime      @default(now())

  events      WebEvent[]

  @@map("web_sessions")
}

model WebEvent {
  id          String     @id @default(uuid())
  tenant      Tenant     @relation(fields: [tenantId], references: [id])
  tenantId    String
  session     WebSession @relation(fields: [sessionId], references: [id])
  sessionId   String
  eventType   String
  eventName   String
  eventData   Json
  url         String?
  metadata    Json?
  createdAt   DateTime   @default(now())

  @@map("web_events")
}

model NotificationTemplate {
  id          String              @id @default(uuid())
  tenant      Tenant              @relation(fields: [tenantId], references: [id])
  tenantId    String
  name        String
  type        NotificationType
  subjectTemplate String?
  contentTemplate String
  variables   Json?
  status      String              @default("active")
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  notifications Notification[]

  @@unique([tenantId, name])
  @@map("notification_templates")
}

model Notification {
  id          String             @id @default(uuid())
  tenant      Tenant             @relation(fields: [tenantId], references: [id])
  tenantId    String
  user        User?              @relation(fields: [userId], references: [id])
  userId      String?
  customer    Customer?          @relation(fields: [customerId], references: [id])
  customerId  String?
  distributor Distributor?       @relation(fields: [distributorId], references: [id])
  distributorId String?
  type        NotificationType
  priority    NotificationPriority @default(NORMAL)
  subject     String?
  content     String
  template    NotificationTemplate? @relation(fields: [templateId], references: [id])
  templateId  String?
  status      NotificationStatus @default(PENDING)
  sentAt      DateTime?
  metadata    Json?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  logs        NotificationLog[]

  @@map("notifications")
}

model NotificationLog {
  id          String          @id @default(uuid())
  tenant      Tenant          @relation(fields: [tenantId], references: [id])
  tenantId    String
  notification Notification    @relation(fields: [notificationId], references: [id])
  notificationId String
  channel      NotificationType
  status       String          // success, failed, retry
  errorMessage String?
  response     Json?
  attempts     Int             @default(1)
  sentAt      DateTime?
  metadata    Json?

  @@map("notification_logs")
}

// 7. Automation Models

model Workflow {
  id           String        @id @default(uuid())
  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  tenantId     String
  name         String
  description  String?
  type         WorkflowType
  definition   Json
  version      Int           @default(1)
  status       WorkflowStatus @default(DRAFT)
  createdBy    User          @relation(fields: [createdById], references: [id])
  createdById  String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  steps        WorkflowStep[]
  triggers     WorkflowTrigger[]
  executions   WorkflowExecution[]

  @@unique([tenantId, name])
  @@map("workflows")
}

model WorkflowStep {
  id          String      @id @default(uuid())
  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  tenantId    String
  workflow    Workflow    @relation(fields: [workflowId], references: [id])
  workflowId  String
  stepIndex   Int
  name        String
  type        String      // action, condition, loop, wait, trigger
  configuration Json
  createdAt   DateTime    @default(now())

  @@unique([workflowId, stepIndex])
  @@map("workflow_steps")
}

model WorkflowTrigger {
  id          String      @id @default(uuid())
  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  tenantId    String
  workflow    Workflow    @relation(fields: [workflowId], references: [id])
  workflowId  String
  type        String      // event, schedule, api, manual
  eventType   String?
  cronExpression String?
  configuration Json?
  status      String      @default("active")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  executions  WorkflowExecution[]

  @@map("workflow_triggers")
}

model WorkflowExecution {
  id           String          @id @default(uuid())
  tenant       Tenant          @relation(fields: [tenantId], references: [id])
  tenantId     String
  workflow     Workflow        @relation(fields: [workflowId], references: [id])
  workflowId   String
  trigger      WorkflowTrigger? @relation(fields: [triggerId], references: [id])
  triggerId    String?
  status       ExecutionStatus  @default(PENDING)
  inputData    Json?
  outputData   Json?
  errorMessage String?
  startedAt    DateTime         @default(now())
  completedAt  DateTime?
  durationMs   Int?
  metadata     Json?

  logs         ExecutionLog[]

  @@map("workflow_executions")
}

model ExecutionLog {
  id          String          @id @default(uuid())
  tenant      Tenant          @relation(fields: [tenantId], references: [id])
  tenantId    String
  execution   WorkflowExecution @relation(fields: [executionId], references: [id])
  executionId String
  step        WorkflowStep?    @relation(fields: [stepId], references: [id])
  stepId      String?
  level       String           // debug, info, warn, error
  message     String
  data        Json?
  createdAt   DateTime         @default(now())

  @@map("execution_logs")
}

// 8. Analytics Models

model Metric {
  id          String     @id @default(uuid())
  tenant      Tenant     @relation(fields: [tenantId], references: [id])
  tenantId    String
  name        String
  description String?
  type        MetricType
  unit        MetricUnit
  category    String?
  query       String
  refreshInterval Int      @default(300)
  status      String       @default("active")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  values      MetricValue[]

  @@unique([tenantId, name])
  @@map("metrics")
}

model MetricValue {
  id          String    @id @default(uuid())
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  tenantId    String
  metric      Metric    @relation(fields: [metricId], references: [id])
  metricId    String
  value       Float
  dimensions  Json?
  timestamp   DateTime
  createdAt   DateTime  @default(now())

  @@map("metric_values")
}

model AnalyticsEvent {
  id          String    @id @default(uuid())
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  tenantId    String
  eventType   String
  user        User?     @relation(fields: [userId], references: [id])
  userId      String?
  customer    Customer? @relation(fields: [customerId], references: [id])
  customerId  String?
  session     WebSession? @relation(fields: [sessionId], references: [id])
  sessionId   String?
  eventData   Json
  metadata    Json?
  timestamp   DateTime

  @@map("analytics_events")
}

model Report {
  id          String    @id @default(uuid())
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  tenantId    String
  name        String
  description String?
  type        String    // table, chart, dashboard, export
  query       String
  parameters  Json?
  status      String    @default("active")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  schedules   ReportSchedule[]

  @@unique([tenantId, name])
  @@map("reports")
}

model ReportSchedule {
  id          String    @id @default(uuid())
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  tenantId    String
  report      Report    @relation(fields: [reportId], references: [id])
  reportId    String
  scheduleType String   // hourly, daily, weekly, monthly, custom
  cronExpression String?
  recipients  Json?
  format      String    // pdf, csv, xlsx, json
  status      String    @default("active")
  lastRunAt   DateTime?
  nextRunAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("report_schedules")
}

model Dashboard {
  id          String    @id @default(uuid())
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  tenantId    String
  name        String
  description String?
  layout      Json?
  status      String    @default("active")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  widgets     DashboardWidget[]

  @@unique([tenantId, name])
  @@map("dashboards")
}

model DashboardWidget {
  id          String    @id @default(uuid())
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  tenantId    String
  dashboard   Dashboard @relation(fields: [dashboardId], references: [id])
  dashboardId String
  report      Report?   @relation(fields: [reportId], references: [id])
  reportId    String?
  type        String    // chart, table, metric, text
  title       String?
  configuration Json?
  position    Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("dashboard_widgets")
}

// 9. Audit Models

model AuditLog {
  id          String     @id @default(uuid())
  tenant      Tenant     @relation(fields: [tenantId], references: [id])
  tenantId    String
  user        User?      @relation(fields: [userId], references: [id])
  userId      String?
  action      AuditAction
  resourceType String
  resourceId  String?
  oldValues   Json?
  newValues   Json?
  ipAddress   String?
  userAgent   String?
  sessionId   String?
  metadata    Json?
  createdAt   DateTime   @default(now())

  @@map("audit_logs")
}

model DataChange {
  id          String     @id @default(uuid())
  tenant      Tenant     @relation(fields: [tenantId], references: [id])
  tenantId    String
  tableName   String
  recordId    String
  operation   AuditAction
  oldValues   Json?
  newValues   Json?
  changedBy   String?
  changedAt   DateTime   @default(now())
  metadata    Json?

  @@map("data_changes")
}

model AccessLog {
  id          String     @id @default(uuid())
  tenant      Tenant     @relation(fields: [tenantId], references: [id])
  tenantId    String
  user        User?      @relation(fields: [userId], references: [id])
  userId      String?
  resourceType String
  resourceId  String?
  action      String
  ipAddress   String?
  userAgent   String?
  result      String     // success, denied, error
  errorMessage String?
  createdAt   DateTime   @default(now())

  @@map("access_logs")
}

model ComplianceRecord {
  id          String     @id @default(uuid())
  tenant      Tenant     @relation(fields: [tenantId], references: [id])
  tenantId    String
  type        String     // gdpr, hipaa, sox, pci, other
  subject     String
  description String?
  evidence    Json?
  status      String     // compliant, non_compliant, remediation
  reviewDate  DateTime?
  reviewedBy  String?
  metadata    Json?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("compliance_records")
}

model RetentionPolicy {
  id          String     @id @default(uuid())
  tenant      Tenant     @relation(fields: [tenantId], references: [id])
  tenantId    String
  resourceType String
  retentionDays Int
  archiveEnabled Boolean  @default(false)
  archiveAfterDays Int?
  deleteEnabled  Boolean  @default(false)
  deleteAfterDays Int?
  status      String      @default("active")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([tenantId, resourceType])
  @@map("retention_policies")
}
