  INBOUND
  OUTBOUND
}

enum VoiceCallOutcome {
  COMPLETED
  TRANSFERRED
  ABANDONED
  FAILED
  VOICEMAIL
}

enum TranscriptRole {
  USER
  ASSISTANT
  SYSTEM
  TOOL
}

model VoiceTranscript {
  id          String         @id @default(uuid())
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId    String         @map("tenant_id")
  session     VoiceSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId   String         @map("session_id")
  role        String
  content     String         @db.Text
  confidence  Float?
  startTimeMs Int?           @map("start_time_ms")
  endTimeMs   Int?           @map("end_time_ms")
  tokensUsed  Int?           @map("tokens_used")
  metadata    Json?
  createdAt   DateTime       @default(now()) @map("created_at")

  @@index([sessionId, createdAt])
  @@map("voice_transcripts")
}

model VoiceAnalytics {
  id                    String            @id @default(uuid())
  tenant                Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId              String            @map("tenant_id")
  session               VoiceSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId             String            @unique @map("session_id")
  durationSeconds       Int               @map("duration_seconds")
  silenceDurationMs     Int               @default(0) @map("silence_duration_ms")
  talkTimeMs            Int               @default(0) @map("talk_time_ms")
  toolCallsCount        Int               @default(0) @map("tool_calls_count")
  humanHandoffTriggered Boolean           @default(false) @map("human_handoff_triggered")
  aiAccuracyScore       Float?            @map("ai_accuracy_score") // 0-100
  customerSatisfaction  Float?            @map("customer_satisfaction") // 1-5 CSAT
  sentimentScore        Float?            @map("sentiment_score") // -1 to 1
  intentDetected        String?           @map("intent_detected")
  outcome               String?
  costUsd               Float?            @map("cost_usd")
  metadata              Json?
  createdAt             DateTime          @default(now()) @map("created_at")

  @@map("voice_analytics")
}

// ============================================================
// RAG EXTENSION (pgvector)
// Note: Requires `extensions: [vector]` in datasource for full pgvector.
// The Embedding model in the canonical schema stores Bytes; this is
// an alternative model with native vector type (requires Prisma 6+
// with postgresqlExtensions preview feature).
// ============================================================

model RagEmbedding {
  id         String                       @id @default(uuid())
  tenant     Tenant                       @relation(fields: [tenantId], references: [id])
  tenantId   String                       @map("tenant_id")
  chunk      RagChunk                     @relation(fields: [chunkId], references: [id], onDelete: Cascade)
  chunkId    String                       @map("chunk_id")
  // pgvector: native vector(1536) type. Requires `extensions = [vector]` on datasource
  // and `previewFeatures = ["postgresqlExtensions"]` on the generator.
  embedding  Unsupported("vector(1536)")?
  model      String // text-embedding-3-small, bge-large, etc.
  dimensions Int                          @default(1536)
  createdAt  DateTime                     @default(now()) @map("created_at")

  @@unique([chunkId, model])
  @@index([tenantId])
  @@map("rag_embeddings")
}

model RagQuery {
  id                String                       @id @default(uuid())
  tenant            Tenant                       @relation(fields: [tenantId], references: [id])
  tenantId          String                       @map("tenant_id")
  agent             AiAgent?                     @relation(fields: [agentId], references: [id])
  agentId           String?                      @map("agent_id")
  conversation      Conversation?                @relation(fields: [conversationId], references: [id])
  conversationId    String?                      @map("conversation_id")
  queryText         String                       @map("query_text") @db.Text
  queryEmbedding    Unsupported("vector(1536)")? @map("query_embedding")
  retrievedChunkIds String[]                     @map("retrieved_chunk_ids")
  responseText      String?                      @map("response_text") @db.Text
  latencyMs         Int?                         @map("latency_ms")
  confidence        Float?
  feedback          String? // positive, negative, neutral
  createdAt         DateTime                     @default(now()) @map("created_at")

  @@index([tenantId, createdAt])
  @@index([agentId])
  @@map("rag_queries")
}

