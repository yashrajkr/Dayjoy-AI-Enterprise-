// 6. Channels Models

// NOTE: Field set below mirrors the actual `voice_sessions` table created by
// `database/migrations/*.sql` (the SQL migrations are authoritative for this
// table — see worklog for the Prisma/SQL reconciliation pass). There is no
// `voice_recordings` table in the applied migrations, so the old
// `VoiceRecording` model (and this model's `recordings` back-relation) were
// removed rather than left pointing at a non-existent table.
model VoiceSession {
  id              String        @id @default(uuid())
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId        String        @map("tenant_id")
  conversation    Conversation? @relation(fields: [conversationId], references: [id])
  conversationId  String?       @map("conversation_id")
  customer        Customer?     @relation(fields: [customerId], references: [id])
  customerId      String?       @map("customer_id")
  user            User?         @relation(fields: [userId], references: [id])
  userId          String?       @map("user_id")
  // Vapi's call id. Mapped to the `vapi_call_id` column; kept as `callId` in
  // the Prisma field name since that's what the webhook handlers / REST
  // controller already reference.
  callId          String?       @unique @map("vapi_call_id")
  direction       String
  // `phoneNumber` maps to `from_number` (the caller's number for the
  // primary inbound-call flow). `toNumber` exposes the DB's `to_number`
  // column separately for callers that need both sides of the call.
  phoneNumber     String?       @map("from_number")
  toNumber        String?       @map("to_number")
  assistantId     String?       @map("assistant_id_vapi")
  status          String        @default("INITIATED")
  outcome         String?
  intentDetected  String?       @map("intent_detected")
  startedAt       DateTime      @default(now()) @map("started_at")
  answeredAt      DateTime?     @map("answered_at")
  endedAt         DateTime?     @map("ended_at")
  durationSeconds Int?          @map("duration_seconds")
  silenceSeconds  Int           @default(0) @map("silence_seconds")
  talkTimeSeconds Int           @default(0) @map("talk_time_seconds")
  recordingUrl    String?       @map("recording_url")
  transcriptUrl   String?       @map("transcript_url")
  costUsd         Float?        @map("cost_usd")
  metadata        Json?
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  transcripts VoiceTranscript[]
  analytics   VoiceAnalytics?

  @@map("voice_sessions")
}

