// Dayjoy Enterprise AI Platform - Prisma Schema
// PostgreSQL + Prisma ORM

// 1. Datasource & Generator

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

// 2. Enums

enum TenantStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  DELETED
}

enum CustomerType {
  INDIVIDUAL
  BUSINESS
}

enum DistributorStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  DELETED
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  DELETED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
  RETURNED
}

enum PaymentStatus {
  PENDING
  PAID
  PARTIALLY_PAID
  REFUNDED
  FAILED
}

enum InventoryTxnReason {
  PURCHASE
  SALE
  RETURN
  ADJUSTMENT
  TRANSFER
  RESERVATION
  RELEASE
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED
  LOST
  DELETED
}

enum InteractionType {
  CALL
  EMAIL
  MEETING
  MESSAGE
  NOTE
  OTHER
}

enum WorkflowType {
  BUSINESS
  AI
  INTEGRATION
  NOTIFICATION
}

enum WorkflowStatus {
  ACTIVE
  INACTIVE
  DRAFT
  ARCHIVED
}

enum ExecutionStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum NotificationType {
  EMAIL
  SMS
  WHATSAPP
  PUSH
  IN_APP
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum NotificationStatus {
  PENDING
  SENDING
  SENT
  FAILED
  CANCELLED
}

enum ChannelType {
  VOICE
  WHATSAPP
  WEB
  API
}

enum AgentType {
  SUPPORT
  SALES
  ONBOARDING
  TECHNICAL
  BILLING
  DISTRIBUTOR
  ADMIN
  VOICE
  WHATSAPP
  WEB
}

enum MemoryType {
  FACT
  PREFERENCE
  HISTORY
  CONTEXT
  SUMMARY
}

enum MetricType {
  COUNT
  SUM
  AVERAGE
  PERCENTAGE
  RATIO
}

enum MetricUnit {
  NUMBER
  PERCENT
  CURRENCY
  DURATION
}

enum AuditAction {
  INSERT
  UPDATE
  DELETE
}

// 3. Core Models

// NOTE: `status` is a plain String, not the `TenantStatus` enum, because the
// deployed table (database/migrations/002_auth.sql) declares it VARCHAR(20)
// with no CHECK constraint — a deliberate, authoritative choice — and the
// application's own validation layer (backend/admin/dto/tenant.dto.ts)
// already accepts 4 values (ACTIVE/SUSPENDED/TRIAL/CLOSED) that don't match
// this file's TenantStatus enum (ACTIVE/SUSPENDED/DELETED). Matching Prisma
// to a strict 3-value native enum would reject TRIAL/CLOSED writes that the
// app already promises to accept. No code imports the generated TenantStatus
// enum type directly, so this reconciliation is safe. See PrismaService /
// the voice_sessions model below for the same authoritative-SQL precedent.
model Tenant {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  status    String   @default("ACTIVE")
  settings  Json?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users                   User[]
  userSessions            UserSession[]
  roles                   Role[]
  userRoles               UserRole[]
  customers               Customer[]
  distributors            Distributor[]
  employees               Employee[]
  products                Product[]
  productCategories       ProductCategory[]
  orders                  Order[]
  leads                   Lead[]
  interactions            Interaction[]
  followUps               FollowUp[]
  agents                  AiAgent[]
  conversations           Conversation[]
  messages                Message[]
  aiMemories              AiMemory[]
  ragSources              RagSource[]
  ragDocuments            RagDocument[]
  ragChunks               RagChunk[]
  ragEmbeddings           RagEmbedding[]
  ragQueries              RagQuery[]
  embeddings              Embedding[]
  voiceSessions           VoiceSession[]
  voiceTranscripts        VoiceTranscript[]
  voiceAnalytics          VoiceAnalytics[]
  whatsappContacts        WhatsappContact[]
  whatsappSessions        WhatsappSession[]
  whatsappMessages        WhatsappMessage[]
  webSessions             WebSession[]
  webEvents               WebEvent[]
  notificationTemplates   NotificationTemplate[]
  notifications           Notification[]
  notificationLogs        NotificationLog[]
  workflows               Workflow[]
  workflowSteps           WorkflowStep[]
  workflowTriggers        WorkflowTrigger[]
  workflowExecutions      WorkflowExecution[]
  executionLogs           ExecutionLog[]
  metrics                 Metric[]
  metricValues            MetricValue[]
  analyticsEvents         AnalyticsEvent[]
  reports                 Report[]
  reportSchedules         ReportSchedule[]
  dashboards              Dashboard[]
  dashboardWidgets        DashboardWidget[]
  auditLogs               AuditLog[]
  dataChanges             DataChange[]
  accessLogs              AccessLog[]
  complianceRecords       ComplianceRecord[]
  retentionPolicies       RetentionPolicy[]
  supportTickets          SupportTicket[]
  appointments            Appointment[]
  productReviews          ProductReview[]
  knowledgeArticles       KnowledgeArticle[]
  leadSources             LeadSource[]
  integrations            Integration[]
  webhookEvents           WebhookEvent[]
  configs                 TenantConfig[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  distributorCommissions  DistributorCommission[]
  // Domain back-relations (products / orders / notifications).
  inventory               Inventory[]
  inventoryTransactions   InventoryTransaction[]
  shipments               Shipment[]
  notificationPreferences NotificationPreference[]
  orderItems              OrderItem[]

  @@map("tenants")
}

model User {
  id              String     @id @default(uuid())
  tenant          Tenant     @relation(fields: [tenantId], references: [id])
  tenantId        String     @map("tenant_id")
  email           String
  passwordHash    String?    @map("password_hash")
  phone           String?
  firstName       String?    @map("first_name")
  lastName        String?    @map("last_name")
  // Denormalized role for fast RBAC checks (kept in sync with UserRole join table).
  role            String?    @default("user")
  isEmailVerified Boolean    @default(false) @map("is_email_verified")
  status          UserStatus @default(ACTIVE)
  lastLoginAt     DateTime?  @map("last_login_at")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  sessions                UserSession[]
  userRoles               UserRole[]
  // 1-1 profile relations (a user may be linked to at most one employee record).
  employee                Employee?
  // 1-N relations.
  customers               Customer[]
  distributors            Distributor[]
  interactions            Interaction[]
  followUps               FollowUp[]
  conversations           Conversation[]
  aiMemories              AiMemory[]
  workflows               Workflow[]
  workflowExecutions      WorkflowExecution[]      @relation("ExecutionCreatedBy")
  knowledgeArticles       KnowledgeArticle[]       @relation("KnowledgeArticleAuthor")
  auditLogs               AuditLog[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  analyticsEvents         AnalyticsEvent[]
  accessLogs              AccessLog[]
  notifications           Notification[]
  webSessions             WebSession[]
  voiceSessions           VoiceSession[]
  // Domain back-relations.
  notificationPreferences NotificationPreference[]
  inventoryTransactions   InventoryTransaction[]
  // Assignment back-relations.
  assignedLeads           Lead[]
  assignedSupportTickets  SupportTicket[]
  assignedAppointments    Appointment[]

  // Email is unique per-tenant (not globally) — the same email address
  // may exist in different tenants. Mirrors the SQL migration
  // `021_fix_user_email_unique.sql` (was previously `email @unique`).
  @@unique([tenantId, email])
  @@map("users")
}

model UserSession {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String   @map("user_id")
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  tenantId  String   @map("tenant_id")
  tokenHash String   @unique @map("token_hash")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("user_sessions")
}

model Role {
  id          String   @id @default(uuid())
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  tenantId    String   @map("tenant_id")
  name        String
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@unique([tenantId, name])
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  resource    String
  action      String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]

  @@unique([resource, action])
  @@map("permissions")
}

model RolePermission {
  role         Role       @relation(fields: [roleId], references: [id])
  roleId       String     @map("role_id")
  permission   Permission @relation(fields: [permissionId], references: [id])
  permissionId String     @map("permission_id")
  createdAt    DateTime   @default(now()) @map("created_at")

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  user       User      @relation(fields: [userId], references: [id])
  userId     String    @map("user_id")
  role       Role      @relation(fields: [roleId], references: [id])
  roleId     String    @map("role_id")
  tenant     Tenant    @relation(fields: [tenantId], references: [id])
  tenantId   String    @map("tenant_id")
  assignedBy String?   @map("assigned_by")
  assignedAt DateTime  @default(now()) @map("assigned_at")
  expiresAt  DateTime? @map("expires_at")

  @@id([userId, roleId])
  @@map("user_roles")
}

// 4. Business Models

model Customer {
  id           String       @id @default(uuid())
  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  tenantId     String       @map("tenant_id")
  user         User?        @relation(fields: [userId], references: [id])
  userId       String?      @map("user_id")
  customerType CustomerType @default(INDIVIDUAL) @map("customer_type")
  companyName  String?      @map("company_name")
  firstName    String?      @map("first_name")
  lastName     String?      @map("last_name")
  email        String?
  phone        String?
  address      Json?
  status       String       @default("active")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  orders           Order[]
  interactions     Interaction[]
  followUps        FollowUp[]
  notifications    Notification[]
  whatsappContacts WhatsappContact[]
  webSessions      WebSession[]
  analyticsEvents  AnalyticsEvent[]
  supportTickets   SupportTicket[]
  appointments     Appointment[]
  productReviews   ProductReview[]
  aiMemories       AiMemory[]
  conversations    Conversation[]
  voiceSessions    VoiceSession[]

  @@index([tenantId, status])
  @@map("customers")
}

model Distributor {
  id              String            @id @default(uuid())
  tenant          Tenant            @relation(fields: [tenantId], references: [id])
  tenantId        String            @map("tenant_id")
  user            User?             @relation(fields: [userId], references: [id])
  userId          String?           @map("user_id")
  distributorCode String            @unique @map("distributor_code")
  companyName     String            @map("company_name")
  contactPerson   String?           @map("contact_person")
  email           String
  phone           String?
  address         Json?
  commissionRate  Float?            @map("commission_rate")
  status          DistributorStatus @default(ACTIVE)
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  orders        Order[]
  commissions   DistributorCommission[]
  appointments  Appointment[]
  notifications Notification[]

  @@index([tenantId, status])
  @@map("distributors")
}

model ProductCategory {
  id          String           @id @default(uuid())
  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  tenantId    String           @map("tenant_id")
  parent      ProductCategory? @relation("CategoryChildren", fields: [parentId], references: [id])
  parentId    String?          @map("parent_id")
  name        String
  slug        String
  description String?
  imageUrl    String?          @map("image_url")
  sortOrder   Int              @default(0) @map("sort_order")
  isActive    Boolean          @default(true) @map("is_active")
  metadata    Json?
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  children ProductCategory[] @relation("CategoryChildren")
  products Product[]

  @@unique([tenantId, slug])
  @@map("product_categories")
}

model Product {
  id               String           @id @default(uuid())
  tenant           Tenant           @relation(fields: [tenantId], references: [id])
  tenantId         String           @map("tenant_id")
  category         ProductCategory? @relation(fields: [categoryId], references: [id])
  categoryId       String?          @map("category_id")
  sku              String
  name             String
  slug             String?
  description      String?
  shortDescription String?          @map("short_description")
  price            Float
  cost             Float?
  compareAtPrice   Float?           @map("compare_at_price")
  currency         String           @default("USD")
  taxRate          Float            @default(0) @map("tax_rate")
  inventoryCount   Int              @default(0) @map("inventory_count")
  attributes       Json?
  images           Json?
  tags             String[]
  status           ProductStatus    @default(ACTIVE)
  metadata         Json?
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  orderItems            OrderItem[]
  reviews               ProductReview[]
  inventory             Inventory?
  inventoryTransactions InventoryTransaction[]

  @@unique([tenantId, sku])
  @@index([tenantId, status])
  @@map("products")
}

model Inventory {
  id                String   @id @default(uuid())
  tenant            Tenant   @relation(fields: [tenantId], references: [id])
  tenantId          String   @map("tenant_id")
  product           Product  @relation(fields: [productId], references: [id])
  productId         String   @unique @map("product_id")
  quantity          Int      @default(0)
  reserved          Int      @default(0)
  lowStockThreshold Int      @default(10) @map("low_stock_threshold")
  warehouseLocation String?  @map("warehouse_location")
  metadata          Json?
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  transactions InventoryTransaction[]

  @@index([tenantId, lowStockThreshold])
  @@map("inventory")
}

model InventoryTransaction {
  id             String             @id @default(uuid())
  tenant         Tenant             @relation(fields: [tenantId], references: [id])
  tenantId       String             @map("tenant_id")
  product        Product            @relation(fields: [productId], references: [id])
  productId      String             @map("product_id")
  inventory      Inventory?         @relation(fields: [inventoryId], references: [id])
  inventoryId    String?            @map("inventory_id")
  quantityChange Int                @map("quantity_change")
  reason         InventoryTxnReason
  referenceType  String?            @map("reference_type")
  referenceId    String?            @map("reference_id")
  notes          String?
  createdBy      User?              @relation(fields: [createdById], references: [id])
  createdById    String?            @map("created_by_id")
  createdAt      DateTime           @default(now()) @map("created_at")

  @@index([tenantId, createdAt])
  @@index([productId, createdAt])
  @@map("inventory_transactions")
}

model Order {
  id              String       @id @default(uuid())
  tenant          Tenant       @relation(fields: [tenantId], references: [id])
  tenantId        String       @map("tenant_id")
  customer        Customer     @relation(fields: [customerId], references: [id])
  customerId      String       @map("customer_id")
  distributor     Distributor? @relation(fields: [distributorId], references: [id])
  distributorId   String?      @map("distributor_id")
  orderNumber     String       @unique @map("order_number")
  status          OrderStatus  @default(PENDING)
  subtotal        Float        @default(0)
  tax             Float?       @default(0)
  shipping        Float?       @default(0)
  discount        Float?       @default(0)
  total           Float        @default(0)
  currency        String       @default("USD")
  shippingAddress Json?        @map("shipping_address")
  billingAddress  Json?        @map("billing_address")
  paymentStatus   String       @default("PENDING") @map("payment_status")
  paymentMethod   String?      @map("payment_method")
  paymentId       String?      @map("payment_id")
  notes           String?
  placedAt        DateTime     @default(now()) @map("placed_at")
  confirmedAt     DateTime?    @map("confirmed_at")
  shippedAt       DateTime?    @map("shipped_at")
  deliveredAt     DateTime?    @map("delivered_at")
  cancelledAt     DateTime?    @map("cancelled_at")
  metadata        Json?
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  items       OrderItem[]
  commissions DistributorCommission[]
  shipments   Shipment[]

  @@index([tenantId, status])
  @@index([customerId])
  @@index([distributorId])
  @@map("orders")
}

model OrderItem {
  id             String   @id @default(uuid())
  tenant         Tenant   @relation(fields: [tenantId], references: [id])
  tenantId       String   @map("tenant_id")
  order          Order    @relation(fields: [orderId], references: [id])
  orderId        String   @map("order_id")
  product        Product  @relation(fields: [productId], references: [id])
  productId      String   @map("product_id")
  productSku     String?  @map("product_sku")
  productName    String?  @map("product_name")
  quantity       Int      @default(1)
  unitPrice      Float    @default(0) @map("unit_price")
  taxRate        Float?   @default(0) @map("tax_rate")
  taxAmount      Float?   @default(0) @map("tax_amount")
  discountAmount Float?   @default(0) @map("discount_amount")
  subtotal       Float    @default(0)
  total          Float    @default(0)
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([productId])
  @@index([orderId])
  @@map("order_items")
}

model Shipment {
  id                String    @id @default(uuid())
  tenant            Tenant    @relation(fields: [tenantId], references: [id])
  tenantId          String    @map("tenant_id")
  order             Order     @relation(fields: [orderId], references: [id])
  orderId           String    @map("order_id")
  trackingNumber    String?   @map("tracking_number")
  carrier           String?
  shippingMethod    String?   @map("shipping_method")
  status            String    @default("CREATED")
  shippedAt         DateTime? @map("shipped_at")
  deliveredAt       DateTime? @map("delivered_at")
  estimatedDelivery DateTime? @map("estimated_delivery")
  cost              Float?
  metadata          Json?
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@index([tenantId, createdAt])
  @@index([orderId])
  @@map("shipments")
}

model Lead {
  id           String     @id @default(uuid())
  tenant       Tenant     @relation(fields: [tenantId], references: [id])
  tenantId     String     @map("tenant_id")
  sourceId     String?    @map("source_id")
  assignedTo   User?      @relation(fields: [assignedToId], references: [id])
  assignedToId String?    @map("assigned_to_id")
  firstName    String?    @map("first_name")
  lastName     String?    @map("last_name")
  email        String?
  phone        String?
  company      String?
  status       LeadStatus @default(NEW)
  score        Int        @default(0)
  metadata     Json?
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  interactions Interaction[]
  followUps    FollowUp[]

  @@index([tenantId, status])
  @@index([assignedToId])
  @@map("leads")
}

model Interaction {
  id               String          @id @default(uuid())
  tenant           Tenant          @relation(fields: [tenantId], references: [id])
  tenantId         String          @map("tenant_id")
  customer         Customer?       @relation(fields: [customerId], references: [id])
  customerId       String?         @map("customer_id")
  lead             Lead?           @relation(fields: [leadId], references: [id])
  leadId           String?         @map("lead_id")
  user             User            @relation(fields: [userId], references: [id])
  userId           String          @map("user_id")
  type             InteractionType
  subject          String?
  description      String?
  outcome          String?
  followUpRequired Boolean         @default(false) @map("follow_up_required")
  followUpDate     DateTime?       @map("follow_up_date")
  metadata         Json?
  createdAt        DateTime        @default(now()) @map("created_at")

  followUps FollowUp[]

  @@index([tenantId, createdAt])
  @@index([customerId])
  @@index([leadId])
  @@index([userId])
  @@map("interactions")
}

model FollowUp {
  id            String          @id @default(uuid())
  tenant        Tenant          @relation(fields: [tenantId], references: [id])
  tenantId      String          @map("tenant_id")
  interaction   Interaction?    @relation(fields: [interactionId], references: [id])
  interactionId String?         @map("interaction_id")
  assignedTo    User            @relation(fields: [assignedToId], references: [id])
  assignedToId  String          @map("assigned_to_id")
  customer      Customer?       @relation(fields: [customerId], references: [id])
  customerId    String?         @map("customer_id")
  lead          Lead?           @relation(fields: [leadId], references: [id])
  leadId        String?         @map("lead_id")
  type          InteractionType
  subject       String
  description   String?
  status        String          @default("pending")
  dueDate       DateTime        @map("due_date")
  completedAt   DateTime?       @map("completed_at")
  metadata      Json?
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  @@map("follow_ups")
}

// 5. AI Models

model AiAgent {
  id            String    @id @default(uuid())
  tenant        Tenant    @relation(fields: [tenantId], references: [id])
  tenantId      String    @map("tenant_id")
  name          String
  type          AgentType
  description   String?
  configuration Json?
  capabilities  Json?
  status        String    @default("active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  conversations Conversation[]
  memories      AiMemory[]
  ragQueries    RagQuery[]

  @@map("ai_agents")
}

model Conversation {
  id         String      @id @default(uuid())
  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  tenantId   String      @map("tenant_id")
  agent      AiAgent     @relation(fields: [agentId], references: [id])
  agentId    String      @map("agent_id")
  user       User?       @relation(fields: [userId], references: [id])
  userId     String?     @map("user_id")
  customer   Customer?   @relation(fields: [customerId], references: [id])
  customerId String?     @map("customer_id")
  channel    ChannelType
  sessionId  String?     @map("session_id")
  status     String      @default("active")
  context    Json?
  metadata   Json?
  startedAt  DateTime    @default(now()) @map("started_at")
  endedAt    DateTime?   @map("ended_at")
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")

  messages         Message[]
  ragQueries       RagQuery[]
  voiceSessions    VoiceSession[]
  whatsappSessions WhatsappSession[]
  whatsappMessages WhatsappMessage[]
  webSessions      WebSession[]

  @@index([tenantId, startedAt])
  @@index([agentId, startedAt])
  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid())
  tenant         Tenant       @relation(fields: [tenantId], references: [id])
  tenantId       String       @map("tenant_id")
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  conversationId String       @map("conversation_id")
  role           String // user, assistant, system
  content        String
  contentType    String       @map("content_type") // text, markdown, audio, image
  metadata       Json?
  tokensUsed     Int?         @map("tokens_used")
  createdAt      DateTime     @default(now()) @map("created_at")

