{
  "name": "dayjoy-enterprise-ai",
  "version": "1.0.0",
  "description": "Dayjoy Enterprise AI Platform - Multi-tenant SaaS with Voice AI, WhatsApp AI, Website AI, RAG, and CRM",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/backend/main.js",
    "lint": "eslint \"{src,test,_shared,auth,users,customers,distributors,products,orders,notifications,ai,knowledge,analytics,admin}/**/*.ts\" --fix",
    "format": "prettier --write \"**/*.ts\" --ignore-path .gitignore",
    "db:generate": "prisma generate --schema ../database/prisma/schema.prisma",
    "db:migrate:deploy": "prisma migrate deploy --schema ../database/prisma/schema.prisma",
    "db:migrate:dev": "prisma migrate dev --schema ../database/prisma/schema.prisma",
    "db:seed": "tsx ../database/seed/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "dependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "^11.1.29",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.0",
    "@nestjs/platform-express": "^11.1.29",
    "@nestjs/platform-socket.io": "^10.3.0",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/terminus": "^10.2.0",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^10.3.0",
    "@prisma/client": "^7.9.1",
    "bcryptjs": "^2.4.3",
    "cheerio": "^1.2.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "csv-parse": "^7.0.2",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^7.4.0",
    "firebase-admin": "^12.4.0",
    "gpt-tokenizer": "^3.4.0",
    "helmet": "^8.3.0",
    "ioredis": "^5.4.1",
    "mammoth": "^1.12.0",
    "nodemailer": "^6.9.14",
    "openai": "^4.67.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdf-parse": "^2.4.5",
    "pg": "^8.12.0",
    "prom-client": "^15.1.0",
    "rxjs": "^7.8.0",
    "twilio": "^6.0.2",
    "uuid": "^9.0.1",
    "winston": "^3.13.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.4.0",
    "@swc/core": "^1.15.47",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/multer": "^1.4.12",
    "@types/node": "^26.2.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^7.2.1",
    "@types/uuid": "^9.0.8",
    "@vitest/coverage-v8": "^2.1.0",
    "prisma": "^7.9.1",
    "supertest": "^7.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.7.2",
    "unplugin-swc": "^1.5.10",
    "vitest": "^2.1.0"
  }
}
