{
  "name": "dayjoyai-production-tests",
  "version": "1.0.0",
  "private": true,
  "description": "Dayjoy AI Enterprise — Production tests for RAG, Voice AI (Vapi), WhatsApp AI, Website AI channels.",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rag": "vitest run rag",
    "test:voice": "vitest run voice",
    "test:whatsapp": "vitest run whatsapp",
    "test:website": "vitest run website",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --config=e2e/playwright.config.ts"
  },
  "dependencies": {},
  "devDependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/testing": "^10.4.0",
    "@playwright/test": "^1.47.0",
    "@prisma/client": "^6.0.0",
    "@swc/core": "^1.15.47",
    "@types/node": "^20.14.0",
    "@vitest/coverage-v8": "^2.1.0",
    "ioredis": "^5.4.1",
    "openai": "^4.67.0",
    "rxjs": "^7.8.0",
    "tsx": "^4.7.0",
    "typescript": "^5.7.2",
    "unplugin-swc": "^1.5.10",
    "vitest": "^2.1.0"
  }
}
