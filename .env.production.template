# =====================================================
# Dayjoy AI Enterprise — PRODUCTION Environment Template
# =====================================================
# Copy to .env.production and fill in real values.
# NEVER commit .env.production to git.
#
# Generate strong secrets with:
#   openssl rand -hex 32

# =====================================================
# App / Runtime (REQUIRED)
# =====================================================
NODE_ENV=production
PORT=3000
APP_URL=https://api.dayjoy.ai
APP_VERSION=1.0.0
CORS_ORIGINS=https://admin.dayjoy.ai,https://customer.dayjoy.ai,https://distributor.dayjoy.ai,https://employee.dayjoy.ai
LOG_LEVEL=warn

# =====================================================
# Database (REQUIRED)
# =====================================================
DATABASE_URL=postgresql://dayjoy:REPLACE_WITH_STRONG_PASSWORD@db.prod.dayjoy.ai:5432/dayjoy_ai
DATABASE_POOL_SIZE=20
DATABASE_CONNECTION_TIMEOUT=30000

# =====================================================
# Redis (REQUIRED)
# =====================================================
REDIS_URL=redis://:REPLACE_WITH_STRONG_PASSWORD@redis.prod.dayjoy.ai:6379

# =====================================================
# JWT / Auth (REQUIRED)
# =====================================================
JWT_SECRET=REPLACE_WITH_64_CHAR_HEX
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d
SESSION_SECRET=REPLACE_WITH_64_CHAR_HEX
BCRYPT_ROUNDS=14

# =====================================================
# OpenAI / LLM (REQUIRED for AI features)
# =====================================================
OPENAI_API_KEY=REPLACE_WITH_REAL_KEY
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536

# =====================================================
# Vapi Voice AI (REQUIRED for Voice channel)
# =====================================================
VAPI_API_KEY=REPLACE_WITH_VAPI_KEY
VAPI_WEBHOOK_SECRET=REPLACE_WITH_WEBHOOK_SECRET
VAPI_ASSISTANT_ID=REPLACE_WITH_ASSISTANT_ID
VAPI_PHONE_NUMBER_ID=REPLACE_WITH_PHONE_NUMBER_ID
VAPI_TRANSFER_PHONE_NUMBER=REPLACE_WITH_SUPPORT_PHONE

# =====================================================
# WhatsApp (REQUIRED for WhatsApp channel)
# =====================================================
WHATSAPP_TOKEN=REPLACE_WITH_META_TOKEN
WHATSAPP_PHONE_NUMBER_ID=REPLACE_WITH_PHONE_ID
WHATSAPP_BUSINESS_ACCOUNT_ID=REPLACE_WITH_BUSINESS_ACCOUNT_ID
WHATSAPP_APP_SECRET=REPLACE_WITH_APP_SECRET
WHATSAPP_WEBHOOK_SECRET=REPLACE_WITH_WEBHOOK_SECRET

# =====================================================
# Twilio (REQUIRED for SMS)
# =====================================================
TWILIO_ACCOUNT_SID=REPLACE_WITH_SID
TWILIO_AUTH_TOKEN=REPLACE_WITH_TOKEN
TWILIO_PHONE_NUMBER=REPLACE_WITH_PHONE

# =====================================================
# Email (REQUIRED for notifications)
# =====================================================
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=REPLACE_WITH_SENDGRID_KEY
SMTP_FROM=no-reply@dayjoy.ai

# =====================================================
# AWS (REQUIRED for production)
# =====================================================
AWS_REGION=ap-south-1
AWS_SECRET_MANAGER_SECRET_ID=dayjoy/prod

# =====================================================
# Encryption (REQUIRED)
# =====================================================
ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_HEX

# =====================================================
# Monitoring (OPTIONAL)
# =====================================================
SENTRY_DSN=
DATADOG_API_KEY=

# =====================================================
# Feature Flags
# =====================================================
FEATURE_VOICE_RECORDING=true
FEATURE_TRANSCRIPTION=true
FEATURE_WHATSAPP_BOT=false
