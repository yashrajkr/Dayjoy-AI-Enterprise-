# backend/ compiles rag/, vapi/, and whatsapp-ai/ directly as sibling source
# trees (see backend/tsconfig.json's "include"). Those folders have no
# package.json/node_modules of their own, so both the TypeScript compiler
# and Node's runtime module resolution need every dependency they use
# (@nestjs/common, openai, class-validator, ...) reachable by walking up
# from wherever those files end up. pnpm's default "isolated" layout only
# symlinks a package's own deps into that package's own node_modules
# (e.g. backend/node_modules), so it never satisfies that lookup.
# shamefully-hoist flattens everything into the root node_modules too.
shamefully-hoist=true
